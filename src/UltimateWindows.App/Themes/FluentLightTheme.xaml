  <SolidColorBrush x:Key="AccentTextBrush" Color="#075969" />
  <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#0F172A" />
  <SolidColorBrush x:Key="ConsoleTextBrush" Color="#A5F3FC" />
  <LinearGradientBrush x:Key="AuditBannerBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E3F3EF" Offset="0" /><GradientStop Color="#F7FAF9" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
