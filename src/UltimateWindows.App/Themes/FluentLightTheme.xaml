<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Pro Light Studio Palette -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F5F4" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="#FFFFFF" />
