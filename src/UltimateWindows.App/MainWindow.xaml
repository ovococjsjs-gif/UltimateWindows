<Window x:Class="UltimateWindows.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:UltimateWindows.App.ViewModels"
        Title="UltimateWindows · Рабочая станция" Width="1360" Height="840" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        SizeChanged="OnWindowSizeChanged">
  <Window.DataContext><vm:MainViewModel /></Window.DataContext>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindTool" />
  </Window.CommandBindings>
  <Window.InputBindings><KeyBinding Key="K" Modifiers="Control" Command="ApplicationCommands.Find" /></Window.InputBindings>
  <Grid Background="{DynamicResource AppBackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceSidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="10,18,10,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5,0,0,26">
          <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentPrimaryBrush}">
            <Path Data="M2,2 L8,2 8,12 12,12 12,2 18,2 18,12 14,18 6,18 2,12 Z" Fill="White" Stretch="Uniform" Width="19" Height="19" />
          </Border>
          <StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="UltimateWindows" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Системные инструменты" Style="{StaticResource HintTextStyle}" />
          </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
          <Button Click="OnToggleThemeClick" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Сменить цветовую тему" ToolTip="Сменить цветовую тему">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE793;" /><TextBlock x:Name="ThemeLabel" Text="Цветовая тема" Margin="10,0,0,0" /></StackPanel>
          </Button>
        </Border>
        <TextBlock DockPanel.Dock="Top" x:Name="NavLabel" Text="РАЗДЕЛЫ" Style="{StaticResource EyebrowText}" Margin="12,0,0,6" />
        <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" AutomationProperties.Name="Разделы программы"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource WorkbenchNavItem}">
          <ListBox.ItemTemplate><DataTemplate>
            <Grid ToolTip="{Binding Title}"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                         Visibility="{Binding CompactNavigation, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding RestartAsAdminCommand}" Content="Получить права…" Margin="0,0,12,0"
                    ToolTip="Перезапуск с правами администратора" Visibility="{Binding IsLimitedMode, Converter={StaticResource BoolToVis}}" />
            <CheckBox Style="{StaticResource PillToggleSwitchStyle}" IsChecked="{Binding IsExpertMode}" Content="Подробности" ToolTip="Показать контекст и технические сведения раздела" />
          </StackPanel>
          <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Command="ApplicationCommands.Find" ToolTip="Поиск по задачам и инструментам (Ctrl+K)" AutomationProperties.Name="Найти инструмент">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" /><TextBlock Text="Найти инструмент" Margin="8,0,20,0" /><TextBlock Text="Ctrl K" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel>
          </Button>
        </DockPanel>
      </Border>
      <StackPanel Grid.Row="1" Margin="20,10,20,8">
        <TextBlock Text="{Binding SelectedSection.Title}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SelectedSection.Guide}" Style="{StaticResource HintTextStyle}" Margin="0,5,0,2" Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
      <ContentControl x:Name="Workspace" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" />
      <Border Grid.Row="3" Background="{DynamicResource SurfaceSidebarBrush}" Padding="14,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}">
        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding PrivilegeBadgeText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0" />
          <TextBlock Text="{Binding StatusNotification}" ToolTip="{Binding StatusNotification}" TextTrimming="CharacterEllipsis" FontSize="11.5" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
