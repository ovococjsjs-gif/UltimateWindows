                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- 4. Белый каталог официальных пакетов сред выполнения -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="📦 Официальные пакеты библиотек Microsoft / OpenAL (подписаны издателями)"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Быстрая установка недостающих пакетов Visual C++, DirectX June 2010, .NET и OpenAL из проверенных репозиториев."
