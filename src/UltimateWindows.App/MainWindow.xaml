<Window x:Class="UltimateWindows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UltimateWindows.App.ViewModels"
        Title="UltimateWindows — Комплексный порядок и здоровье системы"
        Width="1220"
        Height="800"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <!-- Верхняя панель (Бренд + Переключатель Простой/Эксперт + Тема) -->
      <RowDefinition Height="64" />
      <!-- Основная рабочая область -->
      <RowDefinition Height="*" />
      <!-- Нижний прозрачный статус-бар не засоряющего систему хранилища -->
      <RowDefinition Height="44" />
    </Grid.RowDefinitions>

    <!-- ==================== 1. ВЕРХНЯЯ ПАНЕЛЬ ==================== -->
    <Border Grid.Row="0"
            Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource AccentPrimaryBrush}"
                  CornerRadius="8"
                  Width="34"
                  Height="34"
                  Margin="0,0,12,0">
            <TextBlock Text="UW"
                       Foreground="#FFFFFF"
                       FontWeight="Bold"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="UltimateWindows"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding PrivilegeBadgeText}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </StackPanel>

        <!-- Переключатель глубины интерфейса (Простой / Эксперт) и Темы -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource SurfaceBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,6"
                  Margin="0,0,10,0">
            <CheckBox IsChecked="{Binding IsExpertMode}"
                      VerticalContentAlignment="Center"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Cursor="Hand">
              <TextBlock Text="{Binding ExperienceModeLabel}"
                         FontSize="12.5"
                         FontWeight="SemiBold"
                         Margin="6,0,0,0" />
            </CheckBox>
          </Border>

          <Button Style="{StaticResource SecondaryButtonStyle}"
                  Click="OnToggleThemeClick"
                  Content="Тема 🌓" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== 2. БОКОВОЕ МЕНЮ + КОНТЕНТ ==================== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="255" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Левое дружелюбное меню -->
      <Border Grid.Column="0"
              Background="{DynamicResource SidebarBackgroundBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}"
              BorderThickness="0,0,1,0"
              Padding="12,16">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="ОСНОВНЫЕ РАЗДЕЛЫ"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="12,0,0,8" />

            <Button Style="{StaticResource SidebarNavButtonStyle}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="HealthOverview"
                    Content="🏠  Здоровье ПК (Обзор)" />

            <Button Style="{StaticResource SidebarNavButtonStyle}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="SmartCleaner"
                    Content="🧹  Очистка (Пароли 🔒)" />

            <Button Style="{StaticResource SidebarNavButtonStyle}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Optimizer"
                    Content="⚡  Ускорение и Тишина" />

            <Button Style="{StaticResource SidebarNavButtonStyle}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="AntiMiner"
                    Content="🛡️  Защита от майнеров" />

            <Button Style="{StaticResource SidebarNavButtonStyle}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="DllAndRepair"
                    Content="🧩  Лечение DLL и ОС" />

            <Button Style="{StaticResource SidebarNavButtonStyle}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="HardwareAndDrivers"
                    Content="🖥️  Железо и Драйверы" />

            <Border Height="1"
                    Background="{DynamicResource SurfaceBorderBrush}"
                    Margin="8,12" />

            <TextBlock Text="БЕЗОПАСНОСТЬ И ОТКАТ"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="12,0,0,8" />

            <Button Style="{StaticResource SidebarNavButtonStyle}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="TimeMachineVault"
                    Content="⏱️  Машина времени" />
          </StackPanel>

          <!-- Карточка гарантии спокойствия внизу сайдбара -->
          <Border DockPanel.Dock="Bottom"
                  Background="{DynamicResource SafeEmeraldSubtleBrush}"
                  BorderBrush="{DynamicResource SafeEmeraldBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12">
            <StackPanel>
              <TextBlock Text="🔒 Личные данные защищены"
                         FontWeight="SemiBold"
                         FontSize="12.5"
                         Foreground="{DynamicResource SafeEmeraldBrush}" />
              <TextBlock Text="Пароли, автозаполнение форм браузеров и кошельки расширений заблокированы от удаления."
                         TextWrapping="Wrap"
                         FontSize="11.5"
                         Margin="0,4,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>

      <!-- Правая рабочая область -->
      <ScrollViewer Grid.Column="1"
                    VerticalScrollBarVisibility="Auto"
                    Padding="28,22">
        <StackPanel>
          <!-- Заголовок текущего раздела -->
          <TextBlock Text="{Binding CurrentSectionTitle}"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding CurrentSectionSubtitle}"
                     FontSize="13.5"
                     TextWrapping="Wrap"
                     Margin="0,6,0,20"
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <!-- =============== ЭКРАН 1: ГЛАВНЫЙ ОБЗОР (ЗДОРОВЬЕ ПК) =============== -->
          <StackPanel Visibility="{Binding IsOverviewVisible, Converter={StaticResource BoolToVis}}">
            <!-- Главный баннер быстрой проверки -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Кольцо индекса порядка -->
                <Border Grid.Column="0"
                        Width="84"
                        Height="84"
                        CornerRadius="42"
                        BorderBrush="{DynamicResource SafeEmeraldBrush}"
                        BorderThickness="5"
                        Margin="0,0,20,0">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="95"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SafeEmeraldBrush}" />
                    <TextBlock Text="из 100"
                               FontSize="10.5"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Ядро безопасности Phase 0 активно и готово к работе"
                             FontSize="17"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="Каждое изменение системы записывается в компактный журнал отката (несколько килобайт вместо гигабайтов мусора) и отменяется в 1 клик."
                             FontSize="13"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <Button Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding CreateSampleCheckpointCommand}"
                          Content="✨ Проверить Машину времени (тест)"
                          Margin="0,0,0,8" />
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding NavigateCommand}"
                          CommandParameter="TimeMachineVault"
                          Content="Открыть историю и квоту бэкапов" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- Сетка дружелюбных карточек модулей -->
            <ItemsControl ItemsSource="{Binding OverviewCards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,3">
                          <TextBlock Text="{Binding StatusBadge}"
                                     FontSize="11.5"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource SafeEmeraldBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding IconGlyph}" FontSize="20" Margin="0,0,10,0" />
                          <TextBlock Text="{Binding SimpleTitle}"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                      </DockPanel>

                      <TextBlock Text="{Binding SimpleDescription}"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />

                      <!-- Раскрывающийся блок технических деталей в Режиме Эксперта -->
                      <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                              Background="{DynamicResource ExpertPanelBackgroundBrush}"
                              BorderBrush="{DynamicResource ExpertPanelBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="10,8"
                              Margin="0,12,0,0">
                        <StackPanel>
                          <TextBlock Text="Инженерная спецификация (Эксперт):"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource AccentPrimaryBrush}" />
                          <TextBlock Text="{Binding ExpertTechnicalNotes}"
                                     FontSize="11.5"
                                     TextWrapping="Wrap"
                                     Margin="0,3,0,0"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- =============== ЭКРАН 2: БЕРЕЖНАЯ ОЧИСТКА, ГИГИЕНА РЕЕСТРА И КАРТА ДИСКА =============== -->
          <StackPanel Visibility="{Binding IsCleanerVisible, Converter={StaticResource BoolToVis}}">

            <!-- Главная панель бережной очистки с замком паролей -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
              <StackPanel>
                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource SafeEmeraldBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,9"
                        Margin="0,0,0,14">
                  <TextBlock Text="{Binding CleanerStudio.VaultShieldBadgeText}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource SafeEmeraldBrush}" />
                </Border>

                <TextBlock Text="Что проверить и бережно очистить:"
                           FontSize="15.5"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <UniformGrid Columns="2" Margin="0,0,0,14">
                  <CheckBox IsChecked="{Binding CleanerStudio.PreservePasswordsAndAutofill}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Margin="0,0,12,8"
                            Content="🔒 Защищать пароли, логины и автозаполнение форм" />
                  <CheckBox IsChecked="{Binding CleanerStudio.PreserveBrowserSessions}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Margin="0,0,0,8"
                            Content="🛡️ Сохранять активные вкладки и сессии входа" />
                  <CheckBox IsChecked="{Binding CleanerStudio.CleanBrowserCaches}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Margin="0,0,12,8"
                            Content="🌐 Кэш всех браузеров (Chrome, Edge, Яндекс, Firefox и др.)" />
                  <CheckBox IsChecked="{Binding CleanerStudio.CleanSystemTempAndShaders}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Margin="0,0,0,8"
                            Content="🧹 Папки Temp (старше 24ч), шейдеры GPU и архивы сбоев" />
                  <CheckBox IsChecked="{Binding CleanerStudio.CleanRegistryOrphans}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Margin="0,0,12,8"
                            Content="🧬 Гигиена реестра (только удаленные программы + откат)" />
                  <CheckBox IsChecked="{Binding CleanerStudio.EmptyRecycleBin}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Margin="0,0,0,8"
                            Content="🗑️ Очистить Корзину Windows" />
                  <CheckBox IsChecked="{Binding CleanerStudio.IncludeDeveloperCaches}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Margin="0,0,12,4"
                            Content="📦 Кэш пакетов разработчика (npm / pip / NuGet)" />
                </UniformGrid>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                  <Button Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding CleanerStudio.ScanPreviewCommand}"
                          Content="🔍 1. Проверить безопасный объем (без удаления)"
                          Margin="0,0,12,0" />
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding CleanerStudio.ExecuteSafeCleanCommand}"
                          Content="✨ 2. Бережно очистить найденное" />
                </StackPanel>

                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">
                  <TextBlock Text="{Binding CleanerStudio.ScanSummaryHeadline}"
                             FontSize="13.5"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                </Border>

                <Border Visibility="{Binding CleanerStudio.HasBrowserWarnings, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,10,0,0">
                  <TextBlock Text="{Binding CleanerStudio.BrowserWarningBanner}"
                             FontSize="12.5"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>

                <Border Visibility="{Binding CleanerStudio.HasCleanupOutcome, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource SafeEmeraldBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,9"
                        Margin="0,10,0,0">
                  <TextBlock Text="{Binding CleanerStudio.LastCleanupOutcome}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource SafeEmeraldBrush}" />
                </Border>
              </StackPanel>
            </Border>

            <!-- Карточки найденных категорий мусора -->
            <ItemsControl ItemsSource="{Binding CleanerStudio.Categories}" Margin="0,0,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,6">
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,3">
                          <TextBlock Text="{Binding FormattedSize}"
                                     FontSize="12.5"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource SafeEmeraldBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding IconGlyph}" FontSize="18" Margin="0,0,10,0" />
                          <TextBlock Text="{Binding FriendlyTitle}"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </DockPanel>

                      <TextBlock Text="{Binding FriendlyDescription}"
                                 FontSize="12.5"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />

                      <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                              Background="{DynamicResource ExpertPanelBackgroundBrush}"
                              BorderBrush="{DynamicResource ExpertPanelBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="10,7"
                              Margin="0,8,0,0">
                        <TextBlock Text="{Binding ExpertSamplesJoined}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Прозрачный список найденных сирот реестра (если обнаружены) -->
            <Border Visibility="{Binding CleanerStudio.HasRegistryOrphans, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="🧬 Проверенные устаревшие ссылки реестра (системные ветки COM/CLSID не затрагиваются)"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Text="Каждая запись ниже ссылается на реально удаленный .exe файл на локальном диске. Перед очисткой исходные значения сохраняются в компактный журнал Машины времени."
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Margin="0,4,0,12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <ItemsControl ItemsSource="{Binding CleanerStudio.RegistryOrphans}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceElevatedBrush}"
                              BorderBrush="{DynamicResource SurfaceBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="12,8"
                              Margin="0,0,0,8">
                        <StackPanel>
                          <TextBlock Text="{Binding FriendlyReason}"
                                     FontSize="13"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="{Binding MissingReferencedFilePath}"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     Margin="0,2,0,0"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                          <TextBlock Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                     Text="{Binding FullRegistryDisplayPath}"
                                     FontSize="11.5"
                                     TextWrapping="Wrap"
                                     Margin="0,4,0,0"
                                     Foreground="{DynamicResource AccentPrimaryBrush}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Быстрая карта занятого места на диске -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="⚡ Быстрая карта занятого места на диске (без зацикливания на ярлыках)"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Многопоточный анализатор мгновенно показывает, какие папки и тяжелые файлы съедают гигабайты на SSD или HDD."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,5,0,12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding CleanerStudio.SelectDiskPresetCommand}"
                          CommandParameter="UserProfile"
                          Content="👤 Профиль пользователя"
                          Margin="0,0,8,0" />
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding CleanerStudio.SelectDiskPresetCommand}"
                          CommandParameter="Downloads"
                          Content="📥 Загрузки"
                          Margin="0,0,8,0" />
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding CleanerStudio.SelectDiskPresetCommand}"
                          CommandParameter="SystemDrive"
                          Content="💽 Системный диск C:\" />
                </StackPanel>

                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0"
                           Text="{Binding CleanerStudio.DiskMapTargetPath, UpdateSourceTrigger=PropertyChanged}"
                           Background="{DynamicResource SurfaceElevatedBrush}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           BorderBrush="{DynamicResource SurfaceBorderBrush}"
                           Padding="10,8"
                           FontSize="13"
                           Margin="0,0,10,0" />
                  <Button Grid.Column="1"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding CleanerStudio.AnalyzeDiskSpaceCommand}"
                          Content="📊 Построить карту места" />
                </Grid>

                <TextBlock Text="{Binding CleanerStudio.DiskMapStatusText}"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <Grid Visibility="{Binding CleanerStudio.HasDiskMapResults, Converter={StaticResource BoolToVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Левая колонка: Топ папок -->
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="📁 Самые объемные папки:"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding CleanerStudio.TopDirectories}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                  BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="10,8"
                                  Margin="0,0,0,8">
                            <StackPanel>
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding FormattedSize}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                              </DockPanel>
                              <ProgressBar Value="{Binding ShareOfScannedPercent, Mode=OneWay}"
                                           Minimum="0"
                                           Maximum="100"
                                           Height="6"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"
                                           Background="{DynamicResource SurfaceBorderBrush}"
                                           Margin="0,6,0,4" />
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding ShareLabel}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding FilesCountLabel}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                              </DockPanel>
                              <TextBlock Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                         Text="{Binding FullPath}"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         Margin="0,3,0,0"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Правая колонка: Крупнейшие файлы -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="📦 Самые тяжелые отдельные файлы:"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding CleanerStudio.LargestFiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                  BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="10,8"
                                  Margin="0,0,0,8">
                            <StackPanel>
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding FormattedSize}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SafeEmeraldBrush}" />
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                              </DockPanel>
                              <TextBlock Text="{Binding FullPath}"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         Margin="0,4,0,0"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Интерактивная лаборатория проверки любого пути (BrowserVaultGuard) -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Интерактивная проверка фильтра защиты паролей и форм (BrowserVaultGuard)"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Проверьте любой путь к файлу браузера: система на уровне ядра отличает безопасный кэш от ваших сохраненных паролей, автозаполнения форм и сессий."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,6,0,14"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding FillSamplePathCommand}"
                          CommandParameter="C:\Users\User\AppData\Local\Google\Chrome\User Data\Default\Login Data"
                          Content="Пример: Пароли Chrome"
                          Margin="0,0,8,0" />
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding FillSamplePathCommand}"
                          CommandParameter="C:\Users\User\AppData\Local\Microsoft\Edge\User Data\Default\Web Data"
                          Content="Пример: Автозаполнение форм Edge"
                          Margin="0,0,8,0" />
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding FillSamplePathCommand}"
                          CommandParameter="C:\Users\User\AppData\Local\Google\Chrome\User Data\Default\Cache\Cache_Data\f_00041a"
                          Content="Пример: Временный кэш Chrome" />
                </StackPanel>

                <Grid Margin="0,4,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0"
                           Text="{Binding TestPathInput, UpdateSourceTrigger=PropertyChanged}"
                           Background="{DynamicResource SurfaceElevatedBrush}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           BorderBrush="{DynamicResource SurfaceBorderBrush}"
                           Padding="10,8"
                           FontSize="13"
                           Margin="0,0,10,0" />
                  <Button Grid.Column="1"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding EvaluatePathCommand}"
                          Content="Проверить защиту пути" />
                </Grid>

                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">
                  <TextBlock Text="{Binding TestPathVerdict}"
                             FontSize="13.5"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- =============== ЭКРАН 3: МАШИНА ВРЕМЕНИ И НЕ ЗАСОРЯЮЩИЕ ОС БЭКАПЫ =============== -->
          <StackPanel Visibility="{Binding IsTimeMachineVisible, Converter={StaticResource BoolToVis}}">
            <!-- Панель управления не засоряющей систему квотой -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock DockPanel.Dock="Right"
                             Text="{Binding VaultUsageText}"
                             FontSize="14"
                             FontWeight="Bold"
                             Foreground="{DynamicResource SafeEmeraldBrush}" />
                  <TextBlock Text="Контроль чистоты диска (Zero-Bloat Backup Budget)"
                             FontSize="16"
                             FontWeight="SemiBold" />
                </DockPanel>

                <ProgressBar Value="{Binding VaultUsagePercent, Mode=OneWay}"
                             Minimum="0"
                             Maximum="100"
                             Height="10"
                             Foreground="{DynamicResource SafeEmeraldBrush}"
                             Background="{DynamicResource SurfaceElevatedBrush}"
                             Margin="0,0,0,14" />

                <TextBlock Text="Бэкапы UltimateWindows не раздувают систему: настройки реестра сжимаются в килобайты, одинаковые файлы дедуплицируются по SHA-256, а старые архивы карантина автоматически удаляются при достижении лимита или истечении срока."
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Right"
                                 Text="{Binding MaxBudgetMb, StringFormat={}{0} МБ}"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Максимальный потолок под бэкапы:"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DockPanel>
                    <Slider Minimum="32"
                            Maximum="1024"
                            TickFrequency="32"
                            IsSnapToTickEnabled="True"
                            Value="{Binding MaxBudgetMb}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Right"
                                 Text="{Binding RetentionDays, StringFormat={}{0} дн.}"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Автоочистка старых файлов карантина:"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DockPanel>
                    <Slider Minimum="3"
                            Maximum="60"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding RetentionDays}" />
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding SaveQuotaPolicyCommand}"
                          Content="Сохранить настройки квоты"
                          Margin="0,0,10,0" />
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding PurgeBlobsCommand}"
                          Content="🧹 Очистить файловый кэш бэкапов сейчас"
                          Margin="0,0,10,0" />
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding CreateSampleCheckpointCommand}"
                          Content="+ Создать тестовую запись отката" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Лента транзакций отката -->
            <TextBlock Text="Лента изменений (возврат любого действия в 1 клик)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Transactions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <TextBlock Text="{Binding FriendlyTitle}"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     Margin="0,0,10,0" />
                          <TextBlock Text="{Binding CreatedDisplay}"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     Margin="0,0,10,0" />
                          <TextBlock Text="{Binding StoredSizeText}"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource SafeEmeraldBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding FriendlySummary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource ExpertPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource ExpertPanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,8,0,0">
                          <TextBlock Text="{Binding TechnicalDetails}"
                                     FontFamily="Consolas"
                                     FontSize="11.5"
                                     TextWrapping="Wrap" />
                        </Border>
                      </StackPanel>

                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding TogglePinCommand}"
                                Content="{Binding PinButtonText}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RollbackCommand}"
                                IsEnabled="{Binding CanRollback}"
                                Content="↩ Вернуть как было" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- =============== ЭКРАН 3.5: АППАРАТНАЯ СТУДИЯ (ФАЗА 1 — AIDA-КЛАСС & СОВЕТНИК) =============== -->
          <StackPanel Visibility="{Binding IsHardwareVisible, Converter={StaticResource BoolToVis}}"
                      DataContext="{Binding HardwareStudio}">

            <!-- Верхняя плашка оценки конфигурации железа -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="76"
                        Height="76"
                        CornerRadius="38"
                        BorderBrush="{DynamicResource AccentPrimaryBrush}"
                        BorderThickness="4"
                        Margin="0,0,18,0">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding HardwareScore}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentPrimaryBrush}" />
                    <TextBlock Text="индекс ПК"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Паспорт оборудования и Умный советник по скрытым потерям мощности"
                             FontSize="16"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Опрос выполняется без уязвимого драйвера WinRing0 — полная совместимость с Windows 11 HVCI (Целостность памяти) и античитами."
                             FontSize="12.5"
                             TextWrapping="Wrap"
                             Margin="0,4,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshHardwareCommand}"
                        Content="🔄 Обновить датчики и аудит" />
              </Grid>
            </Border>

            <!-- Блок 1: Умный советник по узким местам -->
            <TextBlock Text="Рекомендации Умного советника (поиск потерь FPS и рисков поломки)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />

            <Border Style="{StaticResource CardBorderStyle}"
                    Background="{DynamicResource SafeEmeraldSubtleBrush}"
                    BorderBrush="{DynamicResource SafeEmeraldBrush}"
                    Visibility="{Binding HasNoAdvisories, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,18">
              <TextBlock Text="✅ Скрытых узких мест не обнаружено: частота экрана, режим памяти, профиль питания и S.M.A.R.T. накопителей в полном порядке!"
                         FontSize="13.5"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SafeEmeraldBrush}" />
            </Border>

            <ItemsControl ItemsSource="{Binding Advisories}" Margin="0,0,0,14">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <TextBlock Text="{Binding SimpleTitle}"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     Margin="0,0,10,0" />
                          <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                  BorderBrush="{DynamicResource AmberHighlightBrush}"
                                  BorderThickness="1"
                                  CornerRadius="6"
                                  Padding="8,2">
                            <TextBlock Text="{Binding ImpactBadge}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AmberHighlightBrush}" />
                          </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding SimpleExplanation}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource ExpertPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource ExpertPanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,8,0,0">
                          <TextBlock Text="{Binding ExpertTelemetryDetails}"
                                     FontFamily="Consolas"
                                     FontSize="11.5"
                                     TextWrapping="Wrap" />
                        </Border>
                      </StackPanel>

                      <Button Grid.Column="1"
                              VerticalAlignment="Center"
                              Visibility="{Binding CanAutoFix, Converter={StaticResource BoolToVis}}"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Command="{Binding AutoFixCommand}"
                              Content="{Binding AutoFixLabel}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Блок 2: Шесть карточек подробного паспорта оборудования -->
            <TextBlock Text="Подробный паспорт комплектующих"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,4,0,10" />

            <UniformGrid Columns="2" Margin="0,0,0,12">
              <!-- CPU -->
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                <StackPanel>
                  <TextBlock Text="🧠  Процессор (CPUID &amp; Топология)" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding CpuSummary}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                          Background="{DynamicResource ExpertPanelBackgroundBrush}" BorderBrush="{DynamicResource ExpertPanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock Text="{Binding CpuExpert}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>

              <!-- Плата и BIOS -->
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="🎛️  Материнская плата, BIOS и Питание" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding BoardSummary}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                          Background="{DynamicResource ExpertPanelBackgroundBrush}" BorderBrush="{DynamicResource ExpertPanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock Text="{Binding BoardExpert}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>

              <!-- ОЗУ -->
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                <StackPanel>
                  <TextBlock Text="⚡  Оперативная память и Каналы" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding MemorySummary}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                          Background="{DynamicResource ExpertPanelBackgroundBrush}" BorderBrush="{DynamicResource ExpertPanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock Text="{Binding MemoryExpert}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>

              <!-- Видеокарта -->
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="🎮  Видеокарта и шина PCIe" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding GpuSummary}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                          Background="{DynamicResource ExpertPanelBackgroundBrush}" BorderBrush="{DynamicResource ExpertPanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock Text="{Binding GpuExpert}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>

              <!-- Накопители S.M.A.R.T. -->
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                <StackPanel>
                  <TextBlock Text="💽  Накопители и здоровье S.M.A.R.T." FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding StorageSummary}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                          Background="{DynamicResource ExpertPanelBackgroundBrush}" BorderBrush="{DynamicResource ExpertPanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StorageExpert}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>

              <!-- Монитор EDID -->
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="🖥️  Монитор и частота развертки (EDID)" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding DisplaySummary}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                          Background="{DynamicResource ExpertPanelBackgroundBrush}" BorderBrush="{DynamicResource ExpertPanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock Text="{Binding DisplayExpert}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- Блок 3: Встроенный безопасный стресс-тест с тепловым предохранителем -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <TextBlock DockPanel.Dock="Right"
                             Text="{Binding StressThroughputText}"
                             FontSize="14"
                             FontWeight="Bold"
                             Foreground="{DynamicResource SafeEmeraldBrush}" />
                  <TextBlock Text="🔥 Проверка стабильности ПК под нагрузкой (с тепловым предохранителем Thermal Cutoff)"
                             FontSize="15.5"
                             FontWeight="SemiBold" />
                </DockPanel>

                <TextBlock Text="{Binding StressStatusText}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Right"
                                 Text="{Binding StressDurationSeconds, StringFormat={}{0} сек}"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Длительность теста:" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DockPanel>
                    <Slider Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding StressDurationSeconds}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Right"
                                 Text="{Binding ThermalCutoffCelsius, StringFormat={}{0} °C}"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Авто-стоп при нагреве выше:" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DockPanel>
                    <Slider Minimum="75" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ThermalCutoffCelsius}" />
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding StartStressTestCommand}"
                          IsEnabled="{Binding CanStartStress}"
                          Content="▶ Запустить стресс-тест FPU / ОЗУ"
                          Margin="0,0,10,0" />
                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding StopStressTestCommand}"
                          Visibility="{Binding IsStressRunning, Converter={StaticResource BoolToVis}}"
                          Content="⏹ Остановить" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- =============== ЭКРАН 3.8: ДОКТОР DLL (0xC000007B), АНАЛИЗАТОР BSOD И РЕМОНТ ОС =============== -->
          <StackPanel Visibility="{Binding IsRepairVisible, Converter={StaticResource BoolToVis}}"
                      DataContext="{Binding RepairStudio}">

            <!-- Баннер результата последней операции ремонта -->
            <Border Visibility="{Binding HasRepairActionBanner, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource CardBorderStyle}"
                    BorderBrush="{DynamicResource SafeEmeraldBrush}"
                    Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="{Binding LastRepairActionBanner}"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SafeEmeraldBrush}" />
                <Border Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource ExpertPanelBackgroundBrush}"
                        BorderBrush="{DynamicResource ExpertPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,7"
                        Margin="0,8,0,0">
                  <TextBlock Text="{Binding LastRepairTechnicalLog}"
                             FontSize="11.5"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
