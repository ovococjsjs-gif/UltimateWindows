<Window x:Class="UltimateWindows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UltimateWindows.App.ViewModels"
        xmlns:views="clr-namespace:UltimateWindows.App.Views"
        Title="UltimateWindows v2.0 — Анализатор диска, Оптимизатор, Очистка и Защита ПК"
        Width="1360"
        Height="840"
        MinWidth="1060"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ======================================================================= -->
    <!-- ЛЕВЫЙ НАВИГАЦИОННЫЙ РЕЛЬС (ЧЕТКАЯ ВЕРТИКАЛЬНАЯ НАВИГАЦИЯ С ВЕКТОРАМИ)   -->
    <!-- ======================================================================= -->
    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceSidebarBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>

        <!-- Логотип и версия -->
        <Border DockPanel.Dock="Top"
                Padding="16,16,16,14"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <Border Width="32"
                    Height="32"
                    CornerRadius="8"
                    Background="{DynamicResource AccentPrimaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0">
              <Path Data="{StaticResource IconOptimizer}"
                    Fill="White"
                    Stretch="Uniform"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="ULTIMATE WINDOWS"
                         FontSize="13"
                         FontWeight="Bold" />
              <TextBlock Text="v2.0 PRO PORTABLE"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Нижний блок: Счетчик точек отката Vault + Смена темы -->
        <Border DockPanel.Dock="Bottom"
                Padding="12,10"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0">
          <StackPanel>
            <Border Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,8">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right"
                             Text="{Binding VaultUsageText}"
                             FontSize="11"
                             FontWeight="Bold"
                             Foreground="{DynamicResource SafeEmeraldBrush}" />
                  <TextBlock Text="Zero-Bloat Vault"
                             FontSize="11"
                             FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="{Binding ActiveCheckpointsCount, StringFormat=Активных точек отката: {0}}"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,3,0,0" />
              </StackPanel>
            </Border>

            <Button Style="{StaticResource CompactButtonStyle}"
                    Click="OnToggleThemeClick"
                    HorizontalContentAlignment="Center"
                    Content="Сменить тему (Тёмная / Светлая)" />
          </StackPanel>
        </Border>

        <!-- Кнопки разделов с векторными иконками и активной полосой слева -->
        <StackPanel Margin="8,10">
          <RadioButton GroupName="MainNav"
                       Style="{StaticResource NavRadioButtonStyle}"
                       Tag="{StaticResource IconDashboard}"
                       IsChecked="{Binding IsOverviewNav, Mode=TwoWay}"
                       Content="Сводка и Здоровье" />

          <RadioButton GroupName="MainNav"
                       Style="{StaticResource NavRadioButtonStyle}"
                       Tag="{StaticResource IconDiskCleaner}"
                       IsChecked="{Binding IsCleanerNav, Mode=TwoWay}"
                       Content="Диск, Кэш и Реестр" />

          <RadioButton GroupName="MainNav"
                       Style="{StaticResource NavRadioButtonStyle}"
                       Tag="{StaticResource IconOptimizer}"
                       IsChecked="{Binding IsOptimizerNav, Mode=TwoWay}"
                       Content="Оптимизатор и UWP" />

          <RadioButton GroupName="MainNav"
                       Style="{StaticResource NavRadioButtonStyle}"
                       Tag="{StaticResource IconSecurity}"
                       IsChecked="{Binding IsAntiMinerNav, Mode=TwoWay}"
                       Content="Анти-Майнер" />

          <RadioButton GroupName="MainNav"
                       Style="{StaticResource NavRadioButtonStyle}"
                       Tag="{StaticResource IconRepair}"
                       IsChecked="{Binding IsRepairNav, Mode=TwoWay}"
                       Content="Ремонт ОС и DLL" />

          <RadioButton GroupName="MainNav"
                       Style="{StaticResource NavRadioButtonStyle}"
                       Tag="{StaticResource IconHardware}"
                       IsChecked="{Binding IsHardwareNav, Mode=TwoWay}"
                       Content="Железо и Драйверы" />

          <RadioButton GroupName="MainNav"
                       Style="{StaticResource NavRadioButtonStyle}"
                       Tag="{StaticResource IconVault}"
                       IsChecked="{Binding IsVaultNav, Mode=TwoWay}"
                       Content="Машина времени" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ======================================================================= -->
    <!-- ПРАВАЯ ЧАСТЬ: ВЕРХНЯЯ СТРОКА ОС + РАБОЧАЯ ОБЛАСТЬ + СТРОКА СОСТОЯНИЯ    -->
    <!-- ======================================================================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <!-- Компактная верхняя панель в стиле Optimizer 14.7 -->
      <Border Grid.Row="0"
              Background="{DynamicResource SurfaceSidebarBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,0">
        <DockPanel VerticalAlignment="Center">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="9,3"
                    Margin="0,0,12,0">
              <TextBlock Text="{Binding SystemDriveUsageHeadline}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <CheckBox Style="{StaticResource PillToggleSwitchStyle}"
                      IsChecked="{Binding IsExpertMode}"
                      Margin="0,0,7,0" />
            <TextBlock Text="Эксперт"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{Binding OsDisplayHeader}"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- Полноразмерная рабочая область активного инструмента -->
      <Grid Grid.Row="1">
        <views:OverviewWorkspaceView
          Visibility="{Binding IsOverviewVisible, Converter={StaticResource BoolToVis}}" />

        <views:DiskAndCleanerWorkspaceView
          DataContext="{Binding CleanerStudio}"
          Visibility="{Binding DataContext.IsCleanerVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <views:OptimizerWorkspaceView
          DataContext="{Binding OptimizerStudio}"
          Visibility="{Binding DataContext.IsOptimizerVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <views:SecurityWorkspaceView
          DataContext="{Binding AntiMinerStudio}"
          Visibility="{Binding DataContext.IsAntiMinerVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <views:RepairWorkspaceView
          DataContext="{Binding RepairStudio}"
          Visibility="{Binding DataContext.IsRepairVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <views:HardwareWorkspaceView
          Visibility="{Binding IsHardwareVisible, Converter={StaticResource BoolToVis}}" />

        <views:VaultWorkspaceView
          Visibility="{Binding IsTimeMachineVisible, Converter={StaticResource BoolToVis}}" />
      </Grid>

      <!-- Нижняя строка состояния и телеметрии ПК (как в CCleaner / WizTree) -->
      <Border Grid.Row="2"
              Background="{DynamicResource SurfaceSidebarBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="14,0">
        <DockPanel VerticalAlignment="Center">
          <TextBlock DockPanel.Dock="Right"
                     Text="{Binding HardwareStudio.ShortMachineSpecLine}"
                     FontSize="11"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="16,0,0,0" />
          <TextBlock Text="{Binding StatusNotification}"
                     FontSize="11.5"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
