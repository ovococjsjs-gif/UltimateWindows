                          <TextBlock Text="{Binding ArchitectureBadge}"
                                     FontSize="11.5"
                                     Margin="0,3,0,2"
                                     Foreground="{DynamicResource AccentPrimaryBrush}" />
                          <TextBlock Visibility="{Binding DataContext.IsExpertMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
