<UserControl x:Class="UltimateWindows.App.Views.SecurityWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Навигационные вкладки раздела «Анти-майнер и Защита 2.0» (компактно помещаются в 1024×768) -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceSidebarBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,0">
      <WrapPanel Orientation="Horizontal">
        <RadioButton GroupName="SecuritySubTabs"
                     Style="{StaticResource SubTabRadioStyle}"
                     IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=0}"
                     Content="Обзор угроз" />
        <RadioButton GroupName="SecuritySubTabs"
                     Style="{StaticResource SubTabRadioStyle}"
                     IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=1}"
                     Content="Автозакрепление (18 зон)" />
        <RadioButton GroupName="SecuritySubTabs"
                     Style="{StaticResource SubTabRadioStyle}"
                     IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=2}"
                     Content="Защитник и саботаж" />
        <RadioButton GroupName="SecuritySubTabs"
                     Style="{StaticResource SubTabRadioStyle}"
                     IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=3}"
                     Content="Память и сигнатуры" />
        <RadioButton GroupName="SecuritySubTabs"
                     Style="{StaticResource SubTabRadioStyle}"
                     IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=4}"
                     Content="Карантин (.uwq)" />
      </WrapPanel>
    </Border>

    <!-- Информационный баннер последнего действия -->
    <Border Grid.Row="1"
            Visibility="{Binding HasRemediationBanner, Converter={StaticResource BoolToVis}}"
            Background="{DynamicResource SafeEmeraldSubtleBrush}"
            Padding="14,6">
      <TextBlock Text="{Binding LastRemediationBanner}"
                 FontSize="12"
                 Foreground="{DynamicResource SafeEmeraldBrush}"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- ==================== ВКЛАДКА 0: ЕДИНЫЙ ОБЗОР УГРОЗ И ОХОТНИК DROP-ON-INSPECT ==================== -->
    <Grid Grid.Row="2"
          Margin="12,10"
          Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Background="{DynamicResource SafeEmeraldSubtleBrush}"
                  BorderBrush="{DynamicResource SafeEmeraldBrush}"
                  BorderThickness="1.5"
                  CornerRadius="6"
                  Padding="10,7"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0">
            <TextBlock Text="{Binding SecurityScoreBadge}"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SafeEmeraldBrush}" />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding ScanHeadline}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" />
            <DockPanel Margin="0,5,0,0">
              <CheckBox Style="{StaticResource PillToggleSwitchStyle}"
                        IsChecked="{Binding EnableDropOnInspectProbe}"
                        Margin="0,0,8,0" />
              <TextBlock Text="Ловушка Drop-on-Inspect по CPU + GPU + системный монитор (ловит майнеры, прячущиеся от Диспетчера задач)"
                         FontSize="11.5"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </DockPanel>
          </StackPanel>

          <WrapPanel Grid.Column="2" VerticalAlignment="Center">
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RunSecurityScanCommand}"
                    Content="Полная проверка ПК"
                    Margin="0,0,6,0" />
            <Button Style="{StaticResource CompactButtonStyle}"
                    Command="{Binding RunQuickSecurityScanCommand}"
                    Content="Быстро"
                    Margin="0,0,6,0" />
            <Button Style="{StaticResource DangerButtonStyle}"
                    Visibility="{Binding HasThreats, Converter={StaticResource BoolToVis}}"
                    Command="{Binding NeutralizeAllThreatsCommand}"
                    Content="Обезвредить все" />
          </WrapPanel>
        </Grid>
      </Border>

      <TextBlock Grid.Row="1"
                 Text="{Binding KpiSummaryStrip}"
                 FontSize="11.5"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Margin="2,0,0,6" />

      <DataGrid Grid.Row="2"
                ItemsSource="{Binding Threats}"
                SelectedItem="{Binding SelectedThreat}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Подсистема" Binding="{Binding CategoryLabel}" Width="145" />
          <DataGridTextColumn Header="Угроза" Binding="{Binding SimpleTitle}" Width="205" />
          <DataGridTextColumn Header="Точность" Binding="{Binding ConfidenceBadge}" Width="132" />
          <DataGridTextColumn Header="Понятное объяснение" Binding="{Binding SimpleExplanation}" Width="*" />
          <DataGridTemplateColumn Header="Действие" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Style="{StaticResource DangerButtonStyle}"
                        Padding="8,3"
                        FontSize="11"
                        Visibility="{Binding CanRemediateAny, Converter={StaticResource BoolToVis}}"
                        Command="{Binding QuarantineCommand}"
                        Content="{Binding RecommendedActionLabel}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock Text="Техническое досье выбранной находки" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,3" />
          <TextBlock Text="{Binding SelectedThreatEvidence}"
                     FontSize="11.5"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ==================== ВКЛАДКА 1: РЕВИЗИЯ АВТОЗАКРЕПЛЕНИЯ (18 ЗОН AUTORUNS-КЛАССА) ==================== -->
    <Grid Grid.Row="2"
          Margin="12,10"
          Visibility="{Binding IsPersistenceTab, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox Grid.Column="0"
                    ItemsSource="{Binding ZoneFilterOptions}"
                    SelectedItem="{Binding SelectedZoneFilter}"
                    Margin="0,0,8,0" />
          <TextBox Grid.Column="1"
                   Text="{Binding PersistenceSearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Фильтр по имени ключа, задачи, службы, CLSID или пути к файлу"
                   Margin="0,0,10,0" />
          <CheckBox Grid.Column="2"
                    IsChecked="{Binding OnlyAnomalousPersistenceFilter}"
                    Content="Только подозрительные"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
          <Button Grid.Column="3"
                  Style="{StaticResource CompactButtonStyle}"
                  Command="{Binding RunQuickSecurityScanCommand}"
                  Content="Обновить ревизию" />
        </Grid>
      </Border>

      <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredPersistenceEntries}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Зона закрепления" Binding="{Binding ZoneTitle}" Width="165" />
          <DataGridTextColumn Header="Статус" Binding="{Binding StatusBadge}" Width="105" />
          <DataGridTextColumn Header="Имя записи" Binding="{Binding EntryName}" Width="140" />
          <DataGridTextColumn Header="Команда / Исполняемый файл" Binding="{Binding PayloadCommandOrPath}" Width="1.35*" />
          <DataGridTextColumn Header="Ключ / Источник" Binding="{Binding RegistryOrTaskPath}" Width="1*" />
          <DataGridTemplateColumn Header="Действие" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Style="{StaticResource DangerButtonStyle}"
                        Padding="7,2"
                        FontSize="11"
                        Visibility="{Binding CanRemediate, Converter={StaticResource BoolToVis}}"
                        Command="{Binding RemediateCommand}"
                        Content="Отключить" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <!-- ==================== ВКЛАДКА 2: ЗАЩИТНИК WINDOWS, БРАНДМАУЭР И САБОТАЖ ОС ==================== -->
    <Grid Grid.Row="2"
          Margin="12,10"
          Visibility="{Binding IsDefenderSabotageTab, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <!-- Левая колонка: Исключения и сканер Microsoft Defender -->
      <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="10,9">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Исключения Microsoft Defender"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <WrapPanel Margin="0,0,0,6">
              <Button Style="{StaticResource CompactButtonStyle}"
                      Command="{Binding RunDefenderQuickScanCommand}"
                      Content="Быстрый скан Defender"
                      Margin="0,0,6,2" />
              <Button Style="{StaticResource DangerButtonStyle}"
                      Visibility="{Binding HasDangerousDefenderExclusions, Converter={StaticResource BoolToVis}}"
                      Command="{Binding CleanDefenderExclusionsCommand}"
                      Content="Убрать слепые зоны"
                      Margin="0,0,0,2" />
            </WrapPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Text="{Binding DefenderCustomScanPath, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Папка или файл для принудительной проверки через MpCmdRun.exe"
                       Margin="0,0,6,0" />
              <Button Grid.Column="1"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Padding="10,4"
                      Command="{Binding RunDefenderCustomScanCommand}"
                      Content="Проверить путь" />
            </Grid>
          </StackPanel>

          <DataGrid ItemsSource="{Binding DefenderExclusions}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Тип" Binding="{Binding KindLabel}" Width="82" />
              <DataGridTextColumn Header="Оценка" Binding="{Binding RiskBadge}" Width="135" />
              <DataGridTextColumn Header="Объект" Binding="{Binding Value}" Width="100" />
              <DataGridTextColumn Header="Пояснение" Binding="{Binding Reason}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <!-- Правая колонка: Блокировки политик, Брандмауэр, hosts и скрытые пользователи -->
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="10,9">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.75*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Блокировки ОС, Defender, MRT и hosts"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="9,4"
                    FontSize="11.5"
                    Visibility="{Binding HasSabotageLocks, Converter={StaticResource BoolToVis}}"
                    Command="{Binding HealSabotageCommand}"
                    Content="Снять блокировки" />
          </Grid>

          <DataGrid Grid.Row="1" ItemsSource="{Binding SabotageLocks}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Блокировка" Binding="{Binding SimpleTitle}" Width="175" />
              <DataGridTextColumn Header="Объект" Binding="{Binding TargetDisplayPath}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Grid.Row="2"
                     Text="Саботаж Брандмауэра Windows (блокировка антивирусов и обновлений)"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="0,8,0,4" />

          <DataGrid Grid.Row="3" ItemsSource="{Binding FirewallAnomalies}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Правило" Binding="{Binding DisplayName}" Width="135" />
              <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="105" />
              <DataGridTextColumn Header="Детали" Binding="{Binding SimpleExplanation}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- ==================== ВКЛАДКА 3: ПАМЯТЬ ПРОЦЕССОВ, CPU+GPU И ПОДКЛЮЧАЕМЫЕ PE-SIEVE / YARA ==================== -->
    <Grid Grid.Row="2"
          Margin="12,10"
          Visibility="{Binding IsMemorySignaturesTab, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <!-- PE-sieve (BSD-2-Clause) -->
          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Внешний сканер памяти PE-sieve (BSD-2-Clause, опционально)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Text="{Binding CustomPeSievePath, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Путь к pe-sieve64.exe (автоматически ищется в папке tools\)"
                       Margin="0,0,5,0" />
              <Button Grid.Column="1"
                      Style="{StaticResource CompactButtonStyle}"
                      Command="{Binding BrowsePeSieveCommand}"
                      Content="Обзор…"
                      Margin="0,0,5,0" />
              <Button Grid.Column="2"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Padding="9,4"
                      Command="{Binding RunPeSieveCheckCommand}"
                      Content="Проверить память" />
            </Grid>
          </StackPanel>

          <!-- YARA (BSD-3-Clause) -->
          <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Text="Сигнатурный сканер YARA (BSD-3-Clause, опционально)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Text="{Binding YaraScanTargetPath, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Папка для проверки правилами YARA"
                       Margin="0,0,5,0" />
              <Button Grid.Column="1"
                      Style="{StaticResource CompactButtonStyle}"
                      Command="{Binding BrowseYaraCommand}"
                      Content="yara.exe"
                      Margin="0,0,5,0" />
              <Button Grid.Column="2"
                      Style="{StaticResource CompactButtonStyle}"
                      Command="{Binding BrowseYaraRulesCommand}"
                      Content=".yar"
                      Margin="0,0,5,0" />
              <Button Grid.Column="3"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Padding="9,4"
                      Command="{Binding RunYaraCheckCommand}"
                      Content="Скан YARA" />
            </Grid>
          </StackPanel>

          <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding ExternalScanners}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="Живая телеметрия процессов (CPU + GPU + приватная исполняемая память):"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <TextBox Grid.Column="1"
                 Text="{Binding ProcessSearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Поиск по имени процесса, PID, пути или аргументам запуска" />
      </Grid>

      <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredProcessSnapshots}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="62" />
          <DataGridTextColumn Header="Процесс" Binding="{Binding ProcessName}" Width="135" />
          <DataGridTextColumn Header="CPU (фон → монитор)" Binding="{Binding CpuSummary}" Width="152" />
          <DataGridTextColumn Header="GPU (фон → монитор)" Binding="{Binding GpuSummary}" Width="152" />
          <DataGridTextColumn Header="RWX память" Binding="{Binding PrivateExecutableRegionCount}" Width="100" />
          <DataGridTextColumn Header="Подпись" Binding="{Binding SignatureBadge}" Width="100" />
          <DataGridTextColumn Header="Путь исполняемого файла" Binding="{Binding ExecutablePath}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <!-- ==================== ВКЛАДКА 4: ЖУРНАЛ КАРАНТИНА (.UWQ) И ОТКАТ В 1 КЛИК ==================== -->
    <Grid Grid.Row="2"
          Margin="12,10"
          Visibility="{Binding IsQuarantineTab, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,9" Margin="0,0,0,8">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource CompactButtonStyle}"
                  Command="{Binding RefreshQuarantineCommand}"
                  Content="Обновить карантин" />
          <StackPanel>
            <TextBlock Text="Шифрованный карантин (.uwq) и журнал обезвреживания" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="Все изолированные файлы сжаты и обезврежены внутри контейнера Zero-Bloat Vault. При ложном срабатывании любой объект и ключ реестра можно вернуть на место в один клик."
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <DataGrid Grid.Row="1" ItemsSource="{Binding QuarantineHistory}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Дата и время" Binding="{Binding TimestampLocalText}" Width="145" />
          <DataGridTextColumn Header="Операция" Binding="{Binding FriendlyTitle}" Width="240" />
          <DataGridTextColumn Header="Изолированный объект" Binding="{Binding PrimaryPath}" Width="*" />
          <DataGridTextColumn Header="Статус" Binding="{Binding StatusBadge}" Width="145" />
          <DataGridTemplateColumn Header="Откат" Width="125">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Padding="8,3"
                        FontSize="11"
                        Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}"
                        Command="{Binding RestoreCommand}"
                        Content="Восстановить" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</UserControl>
