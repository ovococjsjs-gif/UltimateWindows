<UserControl x:Class="UltimateWindows.App.Views.SecurityWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Верхняя панель управления охотником -->
    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SafeEmeraldSubtleBrush}"
                BorderBrush="{DynamicResource SafeEmeraldBrush}"
                BorderThickness="1.5"
                CornerRadius="6"
                Padding="12,8"
                VerticalAlignment="Center"
                Margin="0,0,14,0">
          <TextBlock Text="{Binding SecurityScoreBadge}"
                     FontSize="13.5"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SafeEmeraldBrush}" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="{Binding ScanHeadline}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
          <DockPanel Margin="0,6,0,0">
            <CheckBox Style="{StaticResource PillToggleSwitchStyle}"
                      IsChecked="{Binding EnableDropOnInspectProbe}"
                      Margin="0,0,10,0" />
            <TextBlock Text="Стелс-приманка Drop-on-Inspect (ловит майнеры, выключающиеся при открытии Диспетчера задач)"
                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <Button Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding RunSecurityScanCommand}"
                Content="Глубокий поиск майнеров" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Visibility="{Binding HasRemediationBanner, Converter={StaticResource BoolToVis}}"
            Background="{DynamicResource SafeEmeraldSubtleBrush}"
            CornerRadius="6"
            Padding="12,7"
            Margin="0,0,0,10">
      <TextBlock Text="{Binding LastRemediationBanner}" FontSize="12" Foreground="{DynamicResource SafeEmeraldBrush}" />
    </Border>

    <!-- Двухколоночная рабочая зона: Угрозы процессов/Stratum + Разблокировка политик ОС -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.25*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <DataGrid Grid.Column="0" ItemsSource="{Binding Threats}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Угроза" Binding="{Binding SimpleTitle}" Width="210" />
          <DataGridTextColumn Header="Точность" Binding="{Binding ConfidenceBadge}" Width="105" />
          <DataGridTextColumn Header="Детали и доказательства" Binding="{Binding SimpleExplanation}" Width="*" />
          <DataGridTemplateColumn Header="Действие" Width="115">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Style="{StaticResource DangerButtonStyle}"
                        Padding="8,3" FontSize="11"
                        Visibility="{Binding CanQuarantineFileSafely, Converter={StaticResource BoolToVis}}"
                        Command="{Binding QuarantineCommand}"
                        Content="В карантин" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="10,5" FontSize="11.5"
                    Visibility="{Binding HasSabotageLocks, Converter={StaticResource BoolToVis}}"
                    Command="{Binding HealSabotageCommand}"
                    Content="Снять все блокировки" />
            <TextBlock Text="Блокировки ОС после вирусов (IFEO / Политики)"
                       FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>

          <DataGrid ItemsSource="{Binding SabotageLocks}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Блокировка" Binding="{Binding SimpleTitle}" Width="180" />
              <DataGridTextColumn Header="Ключ / Объект" Binding="{Binding TargetDisplayPath}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
