<UserControl x:Class="UltimateWindows.App.Views.OptimizerWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Шаблон одной плотной строки твика в стиле Optimizer 14.7 с PillToggleSwitch -->
    <DataTemplate x:Key="OptimizerTweakRowTemplate">
      <Border Padding="6,6"
              CornerRadius="5"
              Background="Transparent"
              ToolTip="{Binding FriendlyExplanation}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <CheckBox Grid.Column="0"
                    Style="{StaticResource PillToggleSwitchStyle}"
                    IsChecked="{Binding IsApplied, Mode=TwoWay}"
                    VerticalAlignment="Top"
                    Margin="0,2,10,0" />

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding FriendlyTitle}"
                       FontSize="12.5"
                       FontWeight="Medium"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding FriendlyExplanation}"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,1,0,0" />
          </StackPanel>

          <Border Grid.Column="2"
                  Visibility="{Binding RequiresAdministrator, Converter={StaticResource BoolToVis}}"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="5,1"
                  Margin="6,0,0,0"
                  VerticalAlignment="Top">
            <TextBlock Text="Admin" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ВЕРХНЯЯ ПАНЕЛЬ ВКЛАДОК OPTIMIZER + БЫСТРЫЕ ПРОФИЛИ -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceSidebarBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ApplyPresetCommand}" CommandParameter="recommended" Content="Профиль: Рекомендуемый" Margin="0,0,5,0" />
          <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ApplyPresetCommand}" CommandParameter="gaming" Content="Игровой" Margin="0,0,5,0" />
          <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ApplyPresetCommand}" CommandParameter="privacy" Content="Приватность" Margin="0,0,5,0" />
          <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ExportYamlProfileCommand}" ToolTip="Экспортировать активные твики в YAML" Content="YAML ↓" Margin="0,0,4,0" />
          <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ImportYamlProfileCommand}" ToolTip="Импортировать профиль твиков из YAML" Content="YAML ↑" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=0}"
                       Content="Универсальный" />
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=1}"
                       Content="Телеметрия ПО и Игры" />
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=2}"
                       Content="UWP Приложения" />
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=3}"
                       Content="Программы и Автозапуск" />
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=4}"
                       Content="Пингер, DNS и Hosts" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Ненавязчивая полоса уведомления о последнем твике -->
    <Border Grid.Row="1"
            Visibility="{Binding HasActionStatusBanner, Converter={StaticResource BoolToVis}}"
            Background="{DynamicResource AccentSubtleBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,5">
      <TextBlock Text="{Binding ActionStatusBanner}"
                 FontSize="11.5"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- ========================================================================= -->
    <!-- ВКЛАДКА 0: УНИВЕРСАЛЬНЫЕ СИСТЕМНЫЕ ТВИКИ (2 КОЛОНКИ КАК В OPTIMIZER 14.7) -->
    <!-- ========================================================================= -->
    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  Padding="14,12"
                  Visibility="{Binding IsUniversalTweaksTab, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: Система + Дисковый привод -->
        <StackPanel Grid.Column="0">
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Система и отзывчивость"
                         FontSize="13.5" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,8" />
              <ItemsControl ItemsSource="{Binding SystemTweaks}"
                            ItemTemplate="{StaticResource OptimizerTweakRowTemplate}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="Дисковый привод и файловая система NTFS"
                         FontSize="13.5" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,8" />
              <ItemsControl ItemsSource="{Binding DiskTweaks}"
                            ItemTemplate="{StaticResource OptimizerTweakRowTemplate}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Правая колонка: Интерфейс Windows + Защита -->
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Проводник и интерфейс Windows 10 / 11"
                         FontSize="13.5" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,8" />
              <ItemsControl ItemsSource="{Binding UiTweaks}"
                            ItemTemplate="{StaticResource OptimizerTweakRowTemplate}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="Защита сети и периферии (без ослабления Defender)"
                         FontSize="13.5" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,8" />
              <ItemsControl ItemsSource="{Binding SecurityTweaks}"
                            ItemTemplate="{StaticResource OptimizerTweakRowTemplate}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- ========================================================================= -->
    <!-- ВКЛАДКА 1: ТЕЛЕМЕТРИЯ ПРИЛОЖЕНИЙ, ПРИВАТНОСТЬ WINDOWS И ИГРЫ              -->
    <!-- ========================================================================= -->
    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  Padding="14,12"
                  Visibility="{Binding IsPrivacyAndGamingTab, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: Телеметрия приложений + Игровой отклик -->
        <StackPanel Grid.Column="0">
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Телеметрия приложений (Office, Браузеры, VS, NVIDIA)"
                         FontSize="13.5" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,8" />
              <ItemsControl ItemsSource="{Binding AppTelemetryTweaks}"
                            ItemTemplate="{StaticResource OptimizerTweakRowTemplate}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="Игры, мышь 1:1 и сетевой стек"
                         FontSize="13.5" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,8" />
              <ItemsControl ItemsSource="{Binding GamingTweaks}"
                            ItemTemplate="{StaticResource OptimizerTweakRowTemplate}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Правая колонка: Конфиденциальность и реклама Windows -->
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="Конфиденциальность Windows, Copilot и реклама"
                         FontSize="13.5" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,8" />
              <ItemsControl ItemsSource="{Binding PrivacyTweaks}"
                            ItemTemplate="{StaticResource OptimizerTweakRowTemplate}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- ========================================================================= -->
    <!-- ВКЛАДКА 2: УДАЛЕНИЕ UWP-ПРИЛОЖЕНИЙ (ТОЧНЫЙ МАКЕТ OPTIMIZER 14.7)          -->
    <!-- ========================================================================= -->
    <Grid Grid.Row="2"
          Margin="12,10"
          Visibility="{Binding IsUwpTab, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <!-- Таблица UWP пакетов с галочками -->
      <DataGrid Grid.Column="0" ItemsSource="{Binding UwpPackages}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="✓" Width="42">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanSelect}"
                          HorizontalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Приложение UWP" Binding="{Binding FriendlyName}" Width="220" />
          <DataGridTextColumn Header="Пакет Appx" Binding="{Binding RawPackageName}" Width="*" />
          <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="120" />
          <DataGridTextColumn Header="Тип" Binding="{Binding KindBadge}" Width="150" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- Правая колонка управления UWP (как в Optimizer) -->
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
        <StackPanel>
          <TextBlock Text="Управление UWP" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

          <TextBox Text="{Binding UwpSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Фильтр по названию пакета"
                   Margin="0,0,0,10" />

          <Button Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RefreshUwpCommand}"
                  Content="Обновить список"
                  Margin="0,0,0,8" />

          <Button Style="{StaticResource DangerButtonStyle}"
                  Command="{Binding RemoveSelectedUwpCommand}"
                  Content="Удалить выбранные UWP"
                  Margin="0,0,0,14" />

          <CheckBox IsChecked="{Binding HideUwpFrameworks}"
                    Content="Скрывать системные библиотеки (VCLibs, .NET, UI.Xaml)"
                    Margin="0,0,0,12" />

          <UniformGrid Columns="2" Margin="0,0,0,14">
            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ToggleSelectAllUwpCommand}" CommandParameter="true" Content="Выбрать все" Margin="0,0,4,0" />
            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ToggleSelectAllUwpCommand}" CommandParameter="false" Content="Снять все" Margin="4,0,0,0" />
          </UniformGrid>

          <Border Background="{DynamicResource SurfaceElevatedBrush}"
                  CornerRadius="6" Padding="10,8">
            <TextBlock Text="{Binding UwpStatusText}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ========================================================================= -->
    <!-- ВКЛАДКА 3: ДЕИНСТАЛЛЯТОР ПРОГРАММ WIN32 + АВТОЗАПУСК + МЕНЮ + UNLOCKER    -->
    <!-- ========================================================================= -->
    <Grid Grid.Row="2"
          Margin="12,10"
          Visibility="{Binding IsAppsAndStartupTab, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <!-- Левая панель: Деинсталлятор установленных программ (как в CCleaner Tools) -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,8" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Программы" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding AppSearchFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Style="{StaticResource CompactButtonStyle}" Command="{Binding RefreshAllOptimizerDataCommand}" Content="Обновить" />
          </Grid>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredInstalledApps}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Программа" Binding="{Binding DisplayName}" Width="*" />
            <DataGridTextColumn Header="Издатель" Binding="{Binding Publisher}" Width="125" />
            <DataGridTextColumn Header="Версия" Binding="{Binding DisplayVersion}" Width="85" />
            <DataGridTextColumn Header="Размер" Binding="{Binding FormattedSize}" Width="78" />
            <DataGridTemplateColumn Header="Действие" Width="138">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CompactButtonStyle}" Padding="7,2" FontSize="11"
                            Visibility="{Binding HasInstallFolder, Converter={StaticResource BoolToVis}}"
                            Command="{Binding OpenFolderCommand}" Content="Папка" Margin="0,0,4,0" />
                    <Button Style="{StaticResource DangerButtonStyle}" Padding="7,2" FontSize="11"
                            Visibility="{Binding HasUninstaller, Converter={StaticResource BoolToVis}}"
                            Command="{Binding UninstallCommand}" Content="Деинсталл." />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- Правая панель: Автозапуск + Контекстное меню + Разблокировка файлов -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <!-- Автозагрузка с живыми переключателями -->
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Автозагрузка Windows (Startup)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding StartupEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="4,5" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                      <DockPanel>
                        <CheckBox DockPanel.Dock="Left" Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,10,0" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceElevatedBrush}"
                                CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding LocationSource}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding CommandOrTarget}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Контекстное меню Проводника ShellEx -->
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Контекстное меню Проводника (ShellEx)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding ShellExtensions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="4,5" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource CompactButtonStyle}" Padding="8,3" FontSize="11"
                                Command="{Binding ToggleBlockCommand}" Content="{Binding ToggleLabel}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding HandlerName}" FontSize="12" FontWeight="Medium" />
                          <TextBlock Text="{Binding TechnicalPathAndClsid}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Охотник на заблокированные файлы (Restart Manager) -->
          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="Кто держит файл? (Restart Manager Unlocker)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding LockedTargetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                <Button Grid.Column="1" Style="{StaticResource CompactButtonStyle}" Command="{Binding BrowseLockedPathCommand}" Content="Файл..." Margin="0,0,6,0" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Command="{Binding FindLockersCommand}" Content="Найти" />
              </Grid>
              <TextBlock Text="{Binding LockHunterHeadline}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding LockingProcesses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,3">
                      <Button DockPanel.Dock="Right" Style="{StaticResource DangerButtonStyle}" Padding="8,3" FontSize="11"
                              IsEnabled="{Binding CanCloseSafely}"
                              Command="{Binding CloseCommand}" Content="Закрыть" />
                      <TextBlock Text="{Binding DisplayHeadline}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ========================================================================= -->
    <!-- ВКЛАДКА 4: ПИНГЕР + БЫСТРАЯ СМЕНА DNS + РЕДАКТОР HOSTS (КАК В OPTIMIZER)  -->
    <!-- ========================================================================= -->
    <Grid Grid.Row="2"
          Margin="12,10"
          Visibility="{Binding IsNetworkAndHostsTab, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1.15*" />
      </Grid.ColumnDefinitions>

      <!-- Левая колонка: Интерактивный Пингер + Смена DNS -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Пингер и Flush DNS -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Style="{StaticResource CompactButtonStyle}"
                      Command="{Binding FlushDnsCommand}" Content="Сбросить кэш DNS" />
              <TextBlock Text="Пингер задержки и доступности (ICMP + TCP)" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding PingTargetHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
              <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunLatencyTestCommand}" Content="Пинговать" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Button Style="{StaticResource CompactButtonStyle}" Padding="7,3" FontSize="11" Command="{Binding SetQuickPingHostCommand}" CommandParameter="1.1.1.1" Content="1.1.1.1" Margin="0,0,5,0" />
              <Button Style="{StaticResource CompactButtonStyle}" Padding="7,3" FontSize="11" Command="{Binding SetQuickPingHostCommand}" CommandParameter="8.8.8.8" Content="8.8.8.8" Margin="0,0,5,0" />
              <Button Style="{StaticResource CompactButtonStyle}" Padding="7,3" FontSize="11" Command="{Binding SetQuickPingHostCommand}" CommandParameter="ya.ru" Content="ya.ru" Margin="0,0,5,0" />
              <Button Style="{StaticResource CompactButtonStyle}" Padding="7,3" FontSize="11" Command="{Binding SetQuickPingHostCommand}" CommandParameter="steamcommunity.com" Content="Steam" />
            </StackPanel>

            <TextBlock Text="{Binding PingStatsSummary}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />

            <Border Background="#0B0E14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Height="115">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PingPacketLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" Foreground="#A5F3FC" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>

        <!-- Смена DNS -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Быстрое переключение DNS (с бэкапом Vault)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />

            <DataGrid ItemsSource="{Binding DnsPresets}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Профиль DNS" Binding="{Binding FriendlyName}" Width="145" />
                <DataGridTextColumn Header="Серверы" Binding="{Binding ServersDisplay}" Width="125" />
                <DataGridTextColumn Header="Назначение" Binding="{Binding FriendlyBenefit}" Width="*" />
                <DataGridTemplateColumn Header="" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource CompactButtonStyle}" Padding="8,2" FontSize="11"
                              Command="{Binding ApplyCommand}" Content="Включить" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Правая колонка: Редактор файла Hosts -->
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource CompactButtonStyle}"
                    Command="{Binding OpenHostsInNotepadCommand}" Content="Открыть в Блокноте" />
            <TextBlock Text="Редактор системного файла Hosts" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>

          <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="125" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding NewHostIp, UpdateSourceTrigger=PropertyChanged}" ToolTip="IP-адрес (например 0.0.0.0 или 127.0.0.1)" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding NewHostDomain, UpdateSourceTrigger=PropertyChanged}" ToolTip="Домен (например telemetry.example.com)" Margin="0,0,6,0" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddHostEntryCommand}" Content="Добавить" />
          </Grid>

          <TextBlock Grid.Row="2" Text="{Binding HostsStatusSummary}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

          <DataGrid Grid.Row="3" ItemsSource="{Binding HostsEntries}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="IP" Binding="{Binding RedirectIp}" Width="115" />
              <DataGridTextColumn Header="Домен" Binding="{Binding DomainHost}" Width="*" />
              <DataGridTextColumn Header="Вердикт" Binding="{Binding SecurityWarning}" Width="165" />
              <DataGridTemplateColumn Header="" Width="86">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource DangerButtonStyle}" Padding="8,2" FontSize="11"
                            Command="{Binding RemoveCommand}" Content="Удалить" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
