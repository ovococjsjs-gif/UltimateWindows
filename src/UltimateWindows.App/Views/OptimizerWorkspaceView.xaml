<UserControl x:Class="UltimateWindows.App.Views.OptimizerWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:UltimateWindows.App.Views.OptimizerTabs">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Вкладки раздела -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceSidebarBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=0}"
                       Content="Настройки Windows" />
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=1}"
                       Content="Службы" />
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=2}"
                       Content="Планировщик" />
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=3}"
                       Content="Автозагрузка" />
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=4}"
                       Content="Приложения" />
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=5}"
                       Content="Сеть" />
          <RadioButton GroupName="OptSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=6}"
                       Content="Инструменты" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Сообщение о последнем действии -->
    <Border Grid.Row="1"
            Visibility="{Binding HasActionStatusBanner, Converter={StaticResource BoolToVis}}"
            Background="{DynamicResource AccentSubtleBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,6,10,6">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource LinkButtonStyle}"
                Command="{Binding DismissBannerCommand}"
                Content="Скрыть"
                VerticalAlignment="Top"
                Margin="12,0,0,0" />
        <TextBlock Text="{Binding ActionStatusBanner}"
                   FontSize="12"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <tabs:TweaksTabView Grid.Row="2"
                        DataContext="{Binding Tweaks}"
                        Visibility="{Binding DataContext.IsTweaksTab, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVis}}" />

    <tabs:ServicesTabView Grid.Row="2"
                          DataContext="{Binding Services}"
                          Visibility="{Binding DataContext.IsServicesTab, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVis}}" />

    <tabs:TasksTabView Grid.Row="2"
                       DataContext="{Binding Tasks}"
                       Visibility="{Binding DataContext.IsTasksTab, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVis}}" />

    <tabs:StartupTabView Grid.Row="2"
                         Visibility="{Binding IsStartupTab, Converter={StaticResource BoolToVis}}" />

    <tabs:AppsTabView Grid.Row="2"
                      Visibility="{Binding IsAppsTab, Converter={StaticResource BoolToVis}}" />

    <tabs:NetworkTabView Grid.Row="2"
                         Visibility="{Binding IsNetworkTab, Converter={StaticResource BoolToVis}}" />

    <tabs:ToolsTabView Grid.Row="2"
                       Visibility="{Binding IsToolsTab, Converter={StaticResource BoolToVis}}" />
  </Grid>
</UserControl>
