<UserControl x:Class="UltimateWindows.App.Views.OverviewWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,4,20,20" MaxWidth="1500">
      <Border Background="{DynamicResource AuditBannerBrush}" BorderBrush="{DynamicResource ExpertPanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22,18">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="*" MaxWidth="200" /></Grid.ColumnDefinitions>
          <StackPanel>
            <WrapPanel><TextBlock Text="ДИАГНОСТИКА ПК" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,3,12,3" />
              <Border CornerRadius="4" Background="{DynamicResource SurfaceCardBrush}" Padding="7,2"><TextBlock Text="{Binding AuditStamp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" /></Border></WrapPanel>
            <TextBlock AutomationProperties.AutomationId="AuditHeadline" Text="{Binding SmartAuditTitle}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,3" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SmartAuditSubheadline}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
            <TextBlock Text="{Binding AuditDetails}" Style="{StaticResource HintTextStyle}" Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}" />
            <WrapPanel Margin="0,14,0,0">
              <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunOneClickSmartAuditCommand}" Content="Запустить проверку" Visibility="{Binding IsRunningSmartAudit, Converter={StaticResource InverseBoolToVis}}" />
              <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelAuditCommand}" Content="Остановить проверку" Visibility="{Binding IsRunningSmartAudit, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="Только чтение" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource HintTextStyle}" />
            </WrapPanel>
          </StackPanel>
          <!-- Иллюстрация корпуса ПК, не график измеренных данных. -->
          <Viewbox Grid.Column="1" Stretch="Uniform" MaxWidth="160" Margin="18,2,0,2" IsHitTestVisible="False" Focusable="False">
            <Canvas Width="156" Height="112">
              <Path Data="M8,76 L77,43 147,76 77,109Z" Fill="{DynamicResource AccentSubtleBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" />
              <Path Data="M8,62 L77,29 147,62 77,95Z" Fill="{DynamicResource SurfaceSidebarBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
              <Path Data="M8,48 L77,15 147,48 77,81Z" Fill="{DynamicResource ExpertPanelBackgroundBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
              <Path Data="M37,48 L77,29 117,48 77,67Z" Fill="{DynamicResource AccentPrimaryBrush}" />
              <Path Data="M60,48 L77,40 94,48 77,56Z" Fill="White" Opacity="0.9" />
              <Path Data="M17,69 L32,76 M17,83 L32,90 M122,66 L139,58 M122,80 L139,72" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
            </Canvas>
          </Viewbox>
        </Grid>
      </Border>
      <TextBlock Text="Быстрые задачи" FontWeight="SemiBold" FontSize="18" Margin="0,18,0,8" />
      <ItemsControl ItemsSource="{Binding QuickTasks}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Button Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource WorkbenchTile}" AutomationProperties.Name="{Binding Title}">
            <StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="↗" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{Binding Section.Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="20" /></DockPanel>
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,3" />
              <TextBlock Text="{Binding Detail}" Style="{StaticResource HintTextStyle}" /></StackPanel>
          </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Рабочая среда" FontWeight="SemiBold" FontSize="18" Margin="0,16,0,8" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorderStyle}"><StackPanel>
          <TextBlock Text="СИСТЕМНЫЙ ТОМ" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="{Binding SystemDriveUsageHeadline}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,8" />
          <ProgressBar Value="{Binding SystemDriveUsedPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="5" AutomationProperties.Name="Занято на системном томе, процентов" Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource ToggleOffTrackBrush}" BorderThickness="0" />
          <TextBlock Text="Осталось менее 10% места" Foreground="{DynamicResource AmberTextBrush}" Visibility="{Binding IsSystemDriveCriticallyFull, Converter={StaticResource BoolToVis}}" />
        </StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}"><StackPanel>
          <TextBlock Text="ОПЕРАЦИОННАЯ СИСТЕМА" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="{Binding OsDisplayHeader}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" />
        </StackPanel></Border>
      </Grid>
      <Border Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}" Background="{DynamicResource SurfaceSidebarBrush}">
        <DockPanel><Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="TimeMachineVault" Content="Открыть журнал" Margin="12,0,0,0" />
          <StackPanel><TextBlock Text="История изменений" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Проверьте, что менялось и сохранилась ли копия для отката." Style="{StaticResource HintTextStyle}" /></StackPanel>
        </DockPanel>
      </Border>
      <StackPanel Visibility="{Binding HasSmartAuditActions, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
        <TextBlock Text="По результатам проверки" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding SmartAuditActions}"><ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource CardBorderStyle}" Padding="12,9" Margin="0,0,0,6"><DockPanel>
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource CompactButtonStyle}" Command="{Binding JumpCommand}" Content="Открыть раздел" Margin="10,0,0,0" />
            <StackPanel><TextBlock Text="{Binding DomainBadge}" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding SimpleTitle}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding SimpleRecommendation}" Style="{StaticResource HintTextStyle}" /></StackPanel>
          </DockPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
