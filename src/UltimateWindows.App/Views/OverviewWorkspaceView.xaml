<UserControl x:Class="UltimateWindows.App.Views.OverviewWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
    <StackPanel>

      <!-- 1. ВЕРХНИЙ БЛОК: ЖИВОЙ ИНДЕКС ЗДОРОВЬЯ + СИСТЕМНЫЙ ДИСК C:\ -->
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.25*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая карточка: Комплексный аудит ПК -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="74"
                    Height="74"
                    CornerRadius="37"
                    Background="{DynamicResource SafeEmeraldSubtleBrush}"
                    BorderBrush="{DynamicResource SafeEmeraldBrush}"
                    BorderThickness="3.5"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CompositeHealthScore}"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SafeEmeraldBrush}" />
                <TextBlock Text="из 100"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
              <TextBlock Text="{Binding SmartAuditTitle}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding SmartAuditSubheadline}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,4,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RunOneClickSmartAuditCommand}"
                    Content="Запустить полный аудит" />
          </Grid>
        </Border>

        <!-- Правая карточка: Контроль системного диска C:\ (WizTree / Гибернация) -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <Border DockPanel.Dock="Right"
                      Visibility="{Binding IsSystemDriveCriticallyFull, Converter={StaticResource BoolToVis}}"
                      Background="{DynamicResource DangerSubtleBrush}"
                      BorderBrush="{DynamicResource DangerCoralBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="7,2">
                <TextBlock Text="МАЛО МЕСТА!"
                           FontSize="10.5"
                           FontWeight="Bold"
                           Foreground="#FCA5A5" />
              </Border>
              <TextBlock Text="Состояние системного раздела"
                         FontSize="13.5"
                         FontWeight="SemiBold" />
            </DockPanel>

            <TextBlock Text="{Binding SystemDriveUsageHeadline}"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8" />

            <!-- Полоса заполнения диска -->
            <Border Height="9"
                    CornerRadius="4.5"
                    Background="{DynamicResource ToggleOffTrackBrush}"
                    ClipToBounds="True"
                    Margin="0,0,0,12">
              <Border HorizontalAlignment="Left"
                      Width="{Binding SystemDriveUsedPercent, Converter={StaticResource PctToWidth}, ConverterParameter=340}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSystemDriveCriticallyFull}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource DangerCoralBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
            </Border>

            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding JumpToDiskAnalyzerCommand}"
                      Content="Анализ диска"
                      Margin="0,0,8,0" />
              <Button Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding JumpToSpaceSaverCommand}"
                      Content="Освободить ГБ (hiberfil / дубли)" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Найденные точки быстрого улучшения после аудита -->
      <ItemsControl ItemsSource="{Binding SmartAuditActions}"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasSmartAuditActions, Converter={StaticResource BoolToVis}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardBorderStyle}" Padding="12,9" Margin="0,0,0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DomainBadge}" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SimpleTitle}" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SimpleRecommendation}" FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CompactButtonStyle}"
                        Command="{Binding JumpCommand}" Content="Перейти →" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 2. ЖИВАЯ СВОДКА АППАРАТНОЙ КОНФИГУРАЦИИ -->
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="ПРОЦЕССОР" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding HardwareStudio.CpuSummary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding HardwareStudio.MemorySummary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="2" Margin="0,0,12,0">
            <TextBlock Text="ВИДЕОКАРТА И ЭКРАН" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding HardwareStudio.GpuSummary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="3">
            <TextBlock Text="НАКОПИТЕЛИ S.M.A.R.T." FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding HardwareStudio.StorageSummary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 3. ПЛИТКИ РАБОЧИХ ИНСТРУМЕНТОВ (В 3 КОЛОНКИ, ПЛОТНЫЙ DESKTOP-ФОРМАТ) -->
      <UniformGrid Columns="3">
        <!-- 1. Диск и Очистка -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="SmartCleaner"
                    Content="Открыть Диск, Кэш и Реестр →" />
            <StackPanel>
              <TextBlock Text="Диск, очистка 2.0 и реестр" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Прямое чтение индекса NTFS $MFT, карта блоков диска, 98+ правил очистки программ без потери паролей, 13 категорий реестра и дубли SHA-256."
                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- 2. Optimizer -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="Optimizer"
                    Content="Открыть Твики, Службы и Сеть →" />
            <StackPanel>
              <TextBlock Text="Оптимизатор 2.0 (167 настроек)" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="167 переключателей Windows 10/11, телеметрии и игр, менеджер служб и заданий Планировщика, автозапуск, UWP, Пингер, DNS и Hosts."
                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- 3. Анти-Майнер -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="AntiMiner"
                    Content="Открыть Защиту 2.0 →" />
            <StackPanel>
              <TextBlock Text="Анти-Майнер и Защита 2.0" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Ревизия 18 зон автозагрузки, детектор скрытых майнеров и Stratum-пулов, проверка исключений Защитника, брандмауэра и осады ОС."
                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- 4. Ремонт ОС и PE Doctor -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="DllAndRepair"
                    Content="Открыть Ремонт ОС и DLL →" />
            <StackPanel>
              <TextBlock Text="Ремонт 2.0 (107 рецептов и BSOD)" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="107 проверок ОС, 23 официальных пакета VC++ / .NET / DirectX, рекурсивный PE-доктор, справочник ошибок и расшифровка дампов BSOD."
                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- 5. Железо и Драйверы -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="HardwareAndDrivers"
                    Content="Открыть Железо и Драйверы →" />
            <StackPanel>
              <TextBlock Text="Железо 2.0, Бенчмарки и Драйверы" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Паспорт уровня AIDA64, датчики без WinRing0, экспресс-бенчмарк CPU/GPU/ОЗУ/Диска, живой поиск Microsoft Update Catalog и 39 пакетов драйверов."
                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- 6. Программы, Windows 11 и Автопилот -->
        <Border Style="{StaticResource CardBorderStyle}">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="AppsAndAutomation"
                    Content="Открыть Программы и Автопилот →" />
            <StackPanel>
              <TextBlock Text="Программы winget, Win 11 и Автопилот" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Обновление всех программ и каталог из 36 утилит без рекламы, чистый деинсталлятор с поиском хвостов, готовность к Windows 11, расписание и .zip-отчёт."
                         FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
      </UniformGrid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
