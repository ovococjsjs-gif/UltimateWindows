<UserControl x:Class="UltimateWindows.App.Views.AppsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Верхние 5 вкладок раздела «Программы и Автопилот» (помещаются в одну строку на 1024×768 и 1360×840) -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceSidebarBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,0">
      <WrapPanel Orientation="Horizontal">
        <RadioButton GroupName="AppsSubTabs"
                     Style="{StaticResource SubTabRadioStyle}"
                     Padding="10,7" FontSize="12"
                     IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=0}"
                     Content="Обновления winget" />
        <RadioButton GroupName="AppsSubTabs"
                     Style="{StaticResource SubTabRadioStyle}"
                     Padding="10,7" FontSize="12"
                     IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=1}"
                     Content="Каталог программ (36)" />
        <RadioButton GroupName="AppsSubTabs"
                     Style="{StaticResource SubTabRadioStyle}"
                     Padding="10,7" FontSize="12"
                     IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=2}"
                     Content="Чистое удаление" />
        <RadioButton GroupName="AppsSubTabs"
                     Style="{StaticResource SubTabRadioStyle}"
                     Padding="10,7" FontSize="12"
                     IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=3}"
                     Content="Windows 11 и Сон" />
        <RadioButton GroupName="AppsSubTabs"
                     Style="{StaticResource SubTabRadioStyle}"
                     Padding="10,7" FontSize="12"
                     IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=4}"
                     Content="Автопилот и Отчёт" />
      </WrapPanel>
    </Border>

    <!-- Полоса прогресса и текущего статуса раздела -->
    <Border Grid.Row="1"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,7">
      <StackPanel>
        <ProgressBar Style="{StaticResource LoadingBarStyle}"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,5" />
        <TextBlock Text="{Binding StatusBannerText}"
                   FontSize="11.5"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- ==================== ВКЛАДКА 0: ОБНОВЛЕНИЕ ВСЕХ ПРОГРАММ ЧЕРЕЗ WINGET ==================== -->
    <Grid Grid.Row="2"
          Margin="14,12"
          Visibility="{Binding IsUpgradesTab, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,10">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6" Margin="0,0,8,0"
                    Command="{Binding ScanUpgradesCommand}"
                    Content="Проверить обновления" />
            <Button Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6" Margin="0,0,8,0"
                    Command="{Binding UpgradeSelectedCommand}"
                    Content="Обновить отмеченные" />
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Padding="12,6"
                    Command="{Binding UpgradeAllCommand}"
                    Content="Обновить всё в 1 клик" />
          </WrapPanel>

          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="Центр тихого обновления программ (Microsoft winget)"
                       FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{Binding WingetStatusHeadline}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <DataGrid Grid.Row="1"
                ItemsSource="{Binding UpgradablePackages}"
                IsReadOnly="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Выбр." Width="54">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Программа" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
          <DataGridTextColumn Header="Идентификатор пакета" Binding="{Binding PackageId}" IsReadOnly="True" Width="1.6*" />
          <DataGridTextColumn Header="Текущая → Новая версия" Binding="{Binding VersionTransitionDisplay}" IsReadOnly="True" Width="1.4*" />
          <DataGridTextColumn Header="Источник" Binding="{Binding Source}" IsReadOnly="True" Width="95" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <!-- ==================== ВКЛАДКА 1: КАТАЛОГ ПРОГРАММ ПЕРВОЙ НЕОБХОДИМОСТИ (36) ==================== -->
    <Grid Grid.Row="2"
          Margin="14,12"
          Visibility="{Binding IsCatalogTab, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Проверенный каталог программ для чистой установки Windows"
                     FontSize="13.5" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CatalogHeadline}"
                     FontSize="11.5"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,2,0,8" />

          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="12,6"
                    Command="{Binding InstallSelectedCatalogCommand}"
                    Content="Установить отмеченные" />

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource CompactButtonStyle}"
                      Padding="9,5" Margin="0,0,6,0"
                      Command="{Binding SelectPresetHomeCommand}"
                      Content="Набор: Чистая ОС" />
              <Button Style="{StaticResource CompactButtonStyle}"
                      Padding="9,5" Margin="0,0,6,0"
                      Command="{Binding SelectPresetGamerCommand}"
                      Content="Набор: Игровой ПК" />
              <Button Style="{StaticResource CompactButtonStyle}"
                      Padding="9,5" Margin="0,0,6,0"
                      Command="{Binding SelectPresetDevCommand}"
                      Content="Набор: Разработка" />
              <Button Style="{StaticResource CompactButtonStyle}"
                      Padding="9,5"
                      Command="{Binding ClearCatalogSelectionCommand}"
                      Content="Сброс выбора" />
            </WrapPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0"
                 Style="{StaticResource SearchBoxStyle}"
                 Tag="Поиск по названию, назначению или издателю (7-Zip, VLC, Firefox, Steam, Git...)"
                 Text="{Binding CatalogSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,8,0" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding CatalogCategoryOptions}"
                  SelectedIndex="{Binding SelectedCategoryFilterIndex, Mode=TwoWay}"
                  Margin="0,0,8,0" />
        <Button Grid.Column="2"
                Style="{StaticResource SecondaryButtonStyle}"
                Padding="10,6"
                Command="{Binding RefreshCatalogCommand}"
                Content="Сверить с winget" />
      </Grid>

      <DataGrid Grid.Row="2"
                ItemsSource="{Binding FilteredCatalogItems}"
                IsReadOnly="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Уст." Width="50">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Программа" Binding="{Binding DisplayName}" IsReadOnly="True" Width="155" />
          <DataGridTextColumn Header="Категория" Binding="{Binding CategoryBadge}" IsReadOnly="True" Width="156" />
          <DataGridTextColumn Header="Состояние" Binding="{Binding StatusBadge}" IsReadOnly="True" Width="152" />
          <DataGridTextColumn Header="Описание (официальный источник без рекламы)" Binding="{Binding Summary}" IsReadOnly="True" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <!-- ==================== ВКЛАДКА 2: ЧИСТЫЙ ДЕИНСТАЛЛЯТОР С ПОИСКОМ ХВОСТОВ ==================== -->
    <Grid Grid.Row="2"
          Margin="14,12"
          Visibility="{Binding IsUninstallerTab, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Левая колонка: список установленных программ -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource CompactButtonStyle}"
                  Padding="10,6" Margin="8,0,0,0"
                  Command="{Binding RefreshInstalledAppsCommand}"
                  Content="Обновить" />
          <TextBox Style="{StaticResource SearchBoxStyle}"
                   Tag="Фильтр установленных программ..."
                   Text="{Binding UninstallerSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredInstalledApps}"
                  SelectedItem="{Binding SelectedInstalledApp, Mode=TwoWay}"
                  IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Установленная программа" Binding="{Binding DisplayName}" Width="1.6*" />
            <DataGridTextColumn Header="Издатель и версия" Binding="{Binding PublisherAndVersion}" Width="1.2*" />
            <DataGridTextColumn Header="Размер" Binding="{Binding FormattedSize}" Width="82" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- Правая колонка: найденные хвосты AppData / ProgramData / Реестра и действия удаления -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="Чистый деинсталлятор с защитой Машины времени"
                       FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LeftoverSummaryText}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,3,0,8" />
            <WrapPanel Orientation="Horizontal">
              <Button Style="{StaticResource SecondaryButtonStyle}"
                      Padding="9,5" FontSize="11.5" Margin="0,0,6,4"
                      Command="{Binding ScanLeftoversCommand}"
                      Content="Найти хвосты" />
              <Button Style="{StaticResource PrimaryButtonStyle}"
                      Padding="10,5" FontSize="11.5" Margin="0,0,6,4"
                      Command="{Binding UninstallCleanCommand}"
                      Content="Удалить + хвосты" />
              <Button Style="{StaticResource DangerButtonStyle}"
                      Padding="9,5" FontSize="11.5" Margin="0,0,0,4"
                      Command="{Binding ForceRemoveAppCommand}"
                      Content="Принудительно" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FoundLeftovers}"
                  IsReadOnly="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Удалить" Width="58">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Тип" Binding="{Binding KindBadge}" IsReadOnly="True" Width="115" />
            <DataGridTextColumn Header="Путь или ветка реестра" Binding="{Binding TargetPath}" IsReadOnly="True" Width="*" />
            <DataGridTextColumn Header="Объём" Binding="{Binding FormattedSize}" IsReadOnly="True" Width="85" />
          </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="0,8,0,0" Padding="10,6"
                HorizontalAlignment="Right"
                Command="{Binding CleanLeftoversOnlyCommand}"
                Content="Поместить отмеченные хвосты в карантин и очистить" />
      </Grid>
    </Grid>

    <!-- ==================== ВКЛАДКА 3: ГОТОВНОСТЬ К WINDOWS 11, БАТАРЕЯ, СОН И ПАМЯТЬ ==================== -->
    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  Padding="14,12"
                  Visibility="{Binding IsWin11AndSleepTab, Converter={StaticResource BoolToVis}}">
      <StackPanel>

        <!-- Сводная карточка Windows 11 / Windows 10 ESU -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,10">
          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Top"
                    Padding="10,6" Margin="12,0,0,0"
                    Command="{Binding RefreshWin11AndSleepCommand}"
                    Content="Перепроверить" />
            <StackPanel>
              <TextBlock Text="{Binding Win11Headline}"
                         FontSize="14" FontWeight="Bold"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Win11LifecycleDeadline}"
                         FontSize="11.5"
                         Foreground="{DynamicResource AccentTextBrush}"
                         Margin="0,4,0,0"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Win11EsuHeadline}"
                         FontSize="11.5"
                         Foreground="{DynamicResource SafeTextBrush}"
                         Margin="0,2,0,0"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Win11Recommendation}"
                         FontSize="11.5"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,5,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Таблица 7 аппаратных проверок Windows 11 -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,0,10">
          <DataGrid ItemsSource="{Binding Win11Checks}"
                    IsReadOnly="True"
                    BorderThickness="0"
                    MaxHeight="270">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Критерий Windows 11 (24H2/25H2)" Binding="{Binding Title}" Width="1.25*" />
              <DataGridTextColumn Header="На этом ПК" Binding="{Binding CurrentValue}" Width="1.25*" />
              <DataGridTextColumn Header="Статус" Binding="{Binding StatusBadge}" Width="135" />
              <DataGridTextColumn Header="Подсказка без обхода лицензий" Binding="{Binding ActionHint}" Width="1.8*" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- Карточки Батареи, Сна и Проверки оперативной памяти -->
        <UniformGrid Columns="2">
          <Border Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,6,0">
            <StackPanel>
              <TextBlock Text="Износ аккумулятора и диагностика сна"
                         FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{Binding BatteryHeadline}"
                         FontSize="11.5"
                         Foreground="{DynamicResource SafeTextBrush}"
                         TextWrapping="Wrap"
                         Margin="0,5,0,4" />
              <TextBlock Text="{Binding LastWakeSourceText, StringFormat=Последнее пробуждение: {0}}"
                         FontSize="11.5"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,4" />
              <TextBlock Text="{Binding PowerBlockersText}"
                         FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8" />
              <Button Style="{StaticResource CompactButtonStyle}"
                      HorizontalAlignment="Left"
                      Padding="10,5"
                      Command="{Binding ExportBatteryReportCommand}"
                      Content="Сохранить HTML-отчёт батареи (powercfg)" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="6,0,0,0">
            <StackPanel>
              <TextBlock Text="Средство диагностики оперативной памяти Windows"
                         FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{Binding RamDiagnosticText}"
                         FontSize="11.5"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         Margin="0,5,0,8" />
              <TextBlock Text="При подозрении на битые ячейки ОЗУ или случайные синие экраны MEMORY_MANAGEMENT запустите штатную проверку памяти при следующей перезагрузке."
                         FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8" />
              <Button Style="{StaticResource CompactButtonStyle}"
                      HorizontalAlignment="Left"
                      Padding="10,5"
                      Command="{Binding LaunchRamDiagnosticCommand}"
                      Content="Открыть проверку памяти Windows (mdsched.exe)" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>
    </ScrollViewer>

    <!-- ==================== ВКЛАДКА 4: АВТОПИЛОТ (РАСПИСАНИЕ) И ЕДИНЫЙ ДИАГНОСТИЧЕСКИЙ АРХИВ ==================== -->
    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  Padding="14,12"
                  Visibility="{Binding IsAutopilotTab, Converter={StaticResource BoolToVis}}">
      <StackPanel>

        <!-- Блок 1: Фоновое обслуживание в Планировщике заданий Windows -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Фоновый автопилот в Планировщике заданий Windows (\UltimateWindows\AutoMaintenance)"
                       FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Штатное системное задание без постоянно висящих в трее служб: запускается в выбранный час, выполняет бережный уход и само завершается."
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,12" />

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="Периодичность запуска" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding ScheduleFrequencyOptions}"
                          SelectedIndex="{Binding ScheduleFrequencyIndex, Mode=TwoWay}" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="Час запуска" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AvailableHours}"
                          SelectedIndex="{Binding ScheduleRunHour, Mode=TwoWay}" />
              </StackPanel>

              <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ScheduleNextRunText, StringFormat=Текущий статус задания: {0}}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource SafeTextBrush}" />
                <TextBlock Text="{Binding ScheduleLastRunText, StringFormat=Последний прогон: {0}}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
              </StackPanel>
            </Grid>

            <WrapPanel Orientation="Horizontal" Margin="0,2,0,12">
              <CheckBox IsChecked="{Binding ScheduleCleanCache, Mode=TwoWay}"
                        Content="Очищать временный кэш ОС и браузеров (пароли и сессии неприкосновенны)"
                        Margin="0,0,18,6" />
              <CheckBox IsChecked="{Binding ScheduleCheckDrives, Mode=TwoWay}"
                        Content="Проверять здоровье S.M.A.R.T. накопителей"
                        Margin="0,0,18,6" />
              <CheckBox IsChecked="{Binding ScheduleCheckSecurity, Mode=TwoWay}"
                        Content="Проверять автозагрузку и скрытые майнеры"
                        Margin="0,0,0,6" />
            </WrapPanel>

            <WrapPanel Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButtonStyle}"
                      Padding="14,7" Margin="0,0,10,0"
                      Command="{Binding SaveScheduleCommand}"
                      Content="Применить расписание в Планировщике" />
              <Button Style="{StaticResource SecondaryButtonStyle}"
                      Padding="12,7"
                      Command="{Binding RunMaintenanceNowCommand}"
                      Content="Выполнить бережный прогон прямо сейчас" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Блок 2: Единый диагностический отчёт одним файлом (.zip) -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Center"
                    Padding="14,8" Margin="14,0,0,0"
                    Command="{Binding ExportSupportBundleCommand}"
                    Content="Собрать диагностический архив (.zip)" />
            <StackPanel>
              <TextBlock Text="Единый диагностический отчёт одним файлом для обращения за помощью"
                         FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SupportBundleStatusText}"
                         FontSize="11.5"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         Margin="0,4,0,0" />
              <TextBlock Text="Состав архива: 01-DiagnosticSummary.html (наглядная русская сводка) • 02-HardwarePassport.html (паспорт железа и датчиков) • 03-DiagnosticData.json (машинно-читаемые данные)."
                         FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}"
                         TextWrapping="Wrap"
                         Margin="0,5,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
