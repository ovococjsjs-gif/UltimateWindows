<UserControl x:Class="UltimateWindows.App.Views.OptimizerTabs.NetworkTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="14,12,14,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="1.15*" />
    </Grid.ColumnDefinitions>

    <!-- Левая колонка: проверка связи и выбор DNS -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource CompactButtonStyle}"
                    Command="{Binding FlushDnsCommand}" Content="Сбросить кэш DNS" />
            <TextBlock Text="Проверка связи" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>

          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding PingTargetHost, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Адрес сайта или IP-адрес" Margin="0,0,8,0" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunLatencyTestCommand}" Content="Проверить" />
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button Style="{StaticResource CompactButtonStyle}" Padding="7,3" FontSize="11" Command="{Binding SetQuickPingHostCommand}" CommandParameter="1.1.1.1" Content="1.1.1.1" Margin="0,0,5,0" />
            <Button Style="{StaticResource CompactButtonStyle}" Padding="7,3" FontSize="11" Command="{Binding SetQuickPingHostCommand}" CommandParameter="8.8.8.8" Content="8.8.8.8" Margin="0,0,5,0" />
            <Button Style="{StaticResource CompactButtonStyle}" Padding="7,3" FontSize="11" Command="{Binding SetQuickPingHostCommand}" CommandParameter="ya.ru" Content="ya.ru" Margin="0,0,5,0" />
            <Button Style="{StaticResource CompactButtonStyle}" Padding="7,3" FontSize="11" Command="{Binding SetQuickPingHostCommand}" CommandParameter="steamcommunity.com" Content="Steam" />
          </StackPanel>

          <TextBlock Text="{Binding LatencyHeadline}" Style="{StaticResource HintTextStyle}" Margin="0,0,0,4" />
          <TextBlock Text="{Binding PingStatsSummary}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />

          <Border Background="{DynamicResource ConsoleBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Height="115">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding PingPacketLines}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource ConsoleTextBrush}" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Серверы DNS" FontSize="13.5" FontWeight="SemiBold" />
            <TextBlock Text="Прежние серверы сохраняются в «Машине времени»." Style="{StaticResource HintTextStyle}" Margin="0,2,0,0" />
          </StackPanel>

          <DataGrid ItemsSource="{Binding DnsPresets}" IsReadOnly="True" RowHeaderWidth="0">
            <DataGrid.Columns>
              <!-- Карточка узкая, поэтому название, адреса и назначение идут друг под другом -->
              <DataGridTemplateColumn Header="Набор серверов" Width="*" SortMemberPath="FriendlyName">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,2">
                      <TextBlock Text="{Binding FriendlyName}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ServersDisplay}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding FriendlyBenefit}"
                                 FontSize="11.5"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextWrapping="Wrap"
                                 Margin="0,1,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource CompactButtonStyle}" Padding="8,3" FontSize="11"
                            Command="{Binding ApplyCommand}" Content="Включить" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Правая колонка: файл hosts -->
    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Style="{StaticResource CompactButtonStyle}"
                  Command="{Binding OpenHostsInNotepadCommand}" Content="Открыть в Блокноте" />
          <TextBlock Text="Файл hosts" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding NewHostIp, UpdateSourceTrigger=PropertyChanged}" ToolTip="IP-адрес, например 0.0.0.0 или 127.0.0.1" Margin="0,0,6,0" />
          <TextBox Grid.Column="1" Text="{Binding NewHostDomain, UpdateSourceTrigger=PropertyChanged}" ToolTip="Имя сайта, например tracker.example.com" Margin="0,0,6,0" />
          <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddHostEntryCommand}" Content="Добавить" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding HostsStatusSummary}" Style="{StaticResource HintTextStyle}" Margin="0,0,0,8" />

        <DataGrid Grid.Row="3" ItemsSource="{Binding HostsEntries}" IsReadOnly="True" RowHeaderWidth="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="IP-адрес" Binding="{Binding RedirectIp}" Width="100" />
            <DataGridTemplateColumn Header="Имя сайта" Width="*" MinWidth="150" SortMemberPath="DomainHost">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DomainHost}" ToolTip="{Binding DomainHost}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Оценка" Width="150" SortMemberPath="SecurityWarning">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding SecurityWarning}" FontSize="11.5" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource DangerButtonStyle}" Padding="8,3" FontSize="11"
                          Command="{Binding RemoveCommand}" Content="Удалить" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
