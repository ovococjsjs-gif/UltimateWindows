<UserControl x:Class="UltimateWindows.App.Views.OptimizerTabs.TweaksTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>

    <!-- Строка одной настройки: переключатель, название, пояснение, метки и раскрываемые подробности -->
    <DataTemplate x:Key="TweakRowTemplate">
      <Border x:Name="RowBd"
              Padding="14,11,14,10"
              Margin="0,0,0,6"
              CornerRadius="8"
              Background="{DynamicResource SurfaceCardBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <CheckBox Grid.Column="0"
                    Style="{StaticResource PillToggleSwitchStyle}"
                    IsChecked="{Binding IsApplied, Mode=TwoWay}"
                    IsEnabled="{Binding CanToggle}"
                    VerticalAlignment="Top"
                    Margin="0,1,14,0" />

          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Title}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Explanation}"
                       Style="{StaticResource HintTextStyle}"
                       Margin="0,3,0,0" />
            <TextBlock Text="{Binding AdvisoryNote}"
                       Visibility="{Binding HasAdvisoryNote, Converter={StaticResource BoolToVis}}"
                       FontSize="11.5"
                       Foreground="{DynamicResource AmberTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding Chips}"
                          ItemTemplate="{StaticResource ChipTemplate}"
                          Focusable="False"
                          Margin="0,7,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <Button Grid.Column="2"
                  Style="{StaticResource LinkButtonStyle}"
                  Command="{Binding ToggleDetailsCommand}"
                  Content="{Binding DetailsButtonText}"
                  VerticalAlignment="Top"
                  Margin="14,0,0,0" />

          <Border Grid.Row="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                  Background="{DynamicResource SurfaceInputBrush}"
                  BorderBrush="{DynamicResource DividerBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="11,8"
                  Margin="0,8,0,2">
            <StackPanel>
              <TextBlock Text="{Binding DetailsHeadline}"
                         FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 Text="{Binding KindLabel}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding TargetDisplay}"
                                   FontFamily="Consolas"
                                   FontSize="11.5"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StateLine}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,1,0,0" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsDangerous}" Value="True">
          <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource DangerCoralBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="238" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ЛЕВАЯ КОЛОНКА: поиск, разделы каталога, фильтры, профили -->
    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceSidebarBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="10,12,10,10">

        <TextBox DockPanel.Dock="Top"
                 Style="{StaticResource SearchBoxStyle}"
                 Tag="Найти настройку"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel DockPanel.Dock="Bottom">
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,8" />
          <CheckBox IsChecked="{Binding ShowOnlyEnabled}"
                    Content="Только включённые"
                    Margin="4,0,0,6" />
          <CheckBox IsChecked="{Binding HideNotApplicable}"
                    Content="Скрыть неподходящие"
                    ToolTip="Не показывать настройки для другой версии Windows и для программ, которых нет на этом компьютере"
                    Margin="4,0,0,6" />
          <CheckBox IsChecked="{Binding ShowDangerous}"
                    Content="Показать опасные"
                    ToolTip="Настройки, которые ослабляют защиту или устойчивость Windows. В наборы не входят и включаются только после подтверждения"
                    Margin="4,0,0,10" />

          <UniformGrid Columns="2" Margin="0,0,0,8">
            <Button Style="{StaticResource CompactButtonStyle}"
                    Command="{Binding ImportProfileCommand}"
                    Content="Из файла"
                    ToolTip="Открыть файл профиля и включить настройки из него"
                    Margin="0,0,3,0" />
            <Button Style="{StaticResource CompactButtonStyle}"
                    Command="{Binding ExportProfileCommand}"
                    Content="В файл"
                    ToolTip="Сохранить включённые настройки в файл профиля, чтобы применить их на другом компьютере"
                    Margin="3,0,0,0" />
          </UniformGrid>

          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource LinkButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    Content="Обновить"
                    ToolTip="Перечитать состояние настроек из системы" />
            <TextBlock Text="{Binding SummaryText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0" />
          </DockPanel>
        </StackPanel>

        <ListBox ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 Style="{StaticResource CategoryListBoxStyle}"
                 ItemContainerStyle="{StaticResource CategoryListItemStyle}"
                 Margin="0,10,0,4">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding CountText}"
                           FontSize="10.5"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ПРАВАЯ ЧАСТЬ: готовые наборы и список настроек -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,10,8,4">
        <StackPanel>
          <TextBlock Text="ГОТОВЫЕ НАБОРЫ — сначала покажут, что изменится"
                     FontSize="10.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource PresetCardButtonStyle}"
                        Command="{Binding OpenCommand}"
                        ToolTip="{Binding Description}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,1,0,0" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ProgressBar Grid.Row="1"
                   Style="{StaticResource LoadingBarStyle}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

      <ScrollViewer Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="16,2,12,12">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding VisibleTweaks}"
                        ItemTemplate="{StaticResource TweakRowTemplate}"
                        Focusable="False">
            <ItemsControl.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <DockPanel Margin="2,14,2,8">
                      <TextBlock DockPanel.Dock="Right"
                                 Text="{Binding ItemCount, StringFormat=настроек: {0}}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 VerticalAlignment="Bottom" />
                      <TextBlock Text="{Binding Name}"
                                 FontSize="14.5"
                                 FontWeight="SemiBold" />
                    </DockPanel>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ItemsControl.GroupStyle>
          </ItemsControl>

          <Border Visibility="{Binding HasNoVisibleTweaks, Converter={StaticResource BoolToVis}}"
                  Style="{StaticResource CardBorderStyle}"
                  Margin="0,16,0,0"
                  Padding="18,16">
            <StackPanel>
              <TextBlock Text="Под выбранные условия не подходит ни одна настройка"
                         FontSize="13.5"
                         FontWeight="SemiBold" />
              <TextBlock Text="Измените запрос, выберите другой раздел или снимите флажки слева."
                         Style="{StaticResource HintTextStyle}"
                         Margin="0,4,0,8" />
              <Button Style="{StaticResource CompactButtonStyle}"
                      Command="{Binding ClearSearchCommand}"
                      Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}"
                      Content="Очистить поиск"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ПРЕДПРОСМОТР НАБОРА ИЛИ ПРОФИЛЯ поверх вкладки -->
    <Grid Grid.Column="0"
          Grid.ColumnSpan="2"
          Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource OverlayBackdropBrush}">
      <Border DataContext="{Binding Preview}"
              MaxWidth="780"
              Margin="40,24"
              VerticalAlignment="Center"
              Background="{DynamicResource SurfaceCardBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="20,16,20,10">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}"
                       Style="{StaticResource HintTextStyle}"
                       FontSize="12"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding Note}"
                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"
                       FontSize="11.5"
                       Foreground="{DynamicResource AmberTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
          </StackPanel>

          <Border Grid.Row="1"
                  BorderBrush="{DynamicResource DividerBrush}"
                  BorderThickness="0,1,0,1">
            <ScrollViewer MaxHeight="400"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,6,14,6">
              <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                IsEnabled="{Binding IsSelectable}"
                                VerticalAlignment="Top"
                                Margin="0,1,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap" />
                        <Border Style="{StaticResource ToneChipStyle}"
                                Margin="0,3,0,0"
                                CornerRadius="5"
                                Padding="7,3">
                          <TextBlock Text="{Binding StatusText}"
                                     FontWeight="Normal"
                                     FontSize="11"
                                     TextWrapping="Wrap" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <DockPanel Grid.Row="2" Margin="20,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding CancelCommand}"
                      Content="Отмена"
                      Margin="12,0,8,0" />
              <Button Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding ApplyCommand}"
                      IsEnabled="{Binding HasSelection}"
                      Content="{Binding ApplyButtonText}" />
            </StackPanel>
            <TextBlock Text="{Binding FooterText}"
                       Style="{StaticResource HintTextStyle}"
                       FontSize="11"
                       VerticalAlignment="Center" />
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
