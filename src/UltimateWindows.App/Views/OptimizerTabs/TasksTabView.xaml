<UserControl x:Class="UltimateWindows.App.Views.OptimizerTabs.TasksTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="14,12,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right"
              Style="{StaticResource CompactButtonStyle}"
              Command="{Binding RefreshCommand}"
              Content="Обновить"
              VerticalAlignment="Center"
              Margin="10,0,0,0" />
      <TextBox DockPanel.Dock="Left"
               Style="{StaticResource SearchBoxStyle}"
               Width="250"
               Tag="Название, папка или команда"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,12,0" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <RadioButton GroupName="TaskFilter" Style="{StaticResource SegmentRadioStyle}"
                     IsChecked="{Binding FilterMode, Converter={StaticResource IntEq}, ConverterParameter=0}" Content="Все" />
        <RadioButton GroupName="TaskFilter" Style="{StaticResource SegmentRadioStyle}"
                     IsChecked="{Binding FilterMode, Converter={StaticResource IntEq}, ConverterParameter=1}" Content="Сторонние"
                     ToolTip="Задания не из папки \Microsoft и не от Microsoft: обновления программ, фоновые агенты" />
        <RadioButton GroupName="TaskFilter" Style="{StaticResource SegmentRadioStyle}"
                     IsChecked="{Binding FilterMode, Converter={StaticResource IntEq}, ConverterParameter=2}" Content="Включены" />
        <RadioButton GroupName="TaskFilter" Style="{StaticResource SegmentRadioStyle}"
                     IsChecked="{Binding FilterMode, Converter={StaticResource IntEq}, ConverterParameter=3}" Content="Отключены" />
        <RadioButton GroupName="TaskFilter" Style="{StaticResource SegmentRadioStyle}"
                     IsChecked="{Binding FilterMode, Converter={StaticResource IntEq}, ConverterParameter=4}" Content="Из каталога"
                     ToolTip="Задания, которые отключают настройки из каталога" />
      </StackPanel>
    </DockPanel>

    <DockPanel Grid.Row="1" Margin="2,0,0,6">
      <TextBlock DockPanel.Dock="Right"
                 Visibility="{Binding IsLimited, Converter={StaticResource BoolToVis}}"
                 Text="Без прав администратора задания можно только смотреть"
                 FontSize="11"
                 Foreground="{DynamicResource AmberTextBrush}"
                 Margin="12,0,0,0" />
      <TextBlock Text="{Binding SummaryText}"
                 FontSize="11.5"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </DockPanel>

    <ProgressBar Grid.Row="2"
                 Style="{StaticResource LoadingBarStyle}"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

    <DataGrid Grid.Row="3"
              ItemsSource="{Binding View}"
              IsReadOnly="True"
              RowHeaderWidth="0">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Вкл." Width="62" SortMemberPath="IsEnabled">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox Style="{StaticResource PillToggleSwitchStyle}"
                        IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding CanChange}"
                        HorizontalAlignment="Left" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Задание" Width="2*" MinWidth="220" SortMemberPath="TaskPath">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Margin="0,1" ToolTip="{Binding TaskPath}">
                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Folder}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Состояние" Width="106" SortMemberPath="StateText">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentControl Content="{Binding StateChip}"
                              ContentTemplate="{StaticResource ChipTemplate}"
                              Focusable="False"
                              Margin="0,4,0,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="Последний запуск" Binding="{Binding LastRunText}" Width="134" />
        <DataGridTextColumn Header="Следующий запуск" Binding="{Binding NextRunText}" Width="134" />

        <DataGridTemplateColumn Header="Что запускает и зачем" Width="3*" MinWidth="220" SortMemberPath="ActionSummary">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Margin="0,1">
                <TextBlock Text="{Binding ActionSummary}"
                           ToolTip="{Binding ActionSummary}"
                           FontSize="11.5"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Note}"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"
                           ToolTip="{Binding Note}"
                           FontSize="10.5"
                           Foreground="{DynamicResource AccentTextBrush}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="124" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
