<UserControl x:Class="UltimateWindows.App.Views.HardwareWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Верхние вкладки раздела Железо и Драйверы -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceSidebarBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,0">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource CompactButtonStyle}"
                VerticalAlignment="Center"
                Command="{Binding HardwareStudio.RefreshHardwareCommand}"
                Content="Обновить телеметрию" />

        <StackPanel Orientation="Horizontal">
          <RadioButton GroupName="HwSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding HardwareStudio.SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=0}"
                       Content="Паспорт железа и S.M.A.R.T." />
          <RadioButton GroupName="HwSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding HardwareStudio.SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=1}"
                       Content="Официальные WHQL Драйверы" />
          <RadioButton GroupName="HwSubTabs"
                       Style="{StaticResource SubTabRadioStyle}"
                       IsChecked="{Binding HardwareStudio.SelectedSubTabIndex, Converter={StaticResource IntEq}, ConverterParameter=2}"
                       Content="Стресс-тест CPU и Памяти" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ВКЛАДКА 0: ПАСПОРТ ЖЕЛЕЗА + ТАБЛИЦЫ S.M.A.R.T. И СЛОТОВ ОЗУ -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  Padding="14,12"
                  Visibility="{Binding HardwareStudio.IsSpecsTab, Converter={StaticResource BoolToVis}}">
      <StackPanel>

        <!-- Рекомендации Советника по узким местам (XMP, Гц монитора, перегрев) -->
        <ItemsControl ItemsSource="{Binding HardwareStudio.Advisories}" Margin="0,0,0,10">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,6">
                <DockPanel>
                  <Button DockPanel.Dock="Right"
                          Visibility="{Binding CanAutoFix, Converter={StaticResource BoolToVis}}"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Padding="12,5" FontSize="11.5"
                          Command="{Binding AutoFixCommand}"
                          Content="{Binding AutoFixLabel}"
                          VerticalAlignment="Center" Margin="10,0,0,0" />
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding SimpleTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0" />
                      <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="6,1">
                        <TextBlock Text="{Binding ImpactBadge}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SimpleExplanation}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 6 карточек узлов ПК (3×2) -->
        <UniformGrid Columns="3" Margin="0,0,0,10">
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
            <StackPanel>
              <TextBlock Text="ПРОЦЕССОР (CPU)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding HardwareStudio.CpuSummary}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" Margin="0,5,0,4" />
              <TextBlock Text="{Binding HardwareStudio.CpuExpert}" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
            <StackPanel>
              <TextBlock Text="ПЛАТА И BIOS (SMBIOS)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding HardwareStudio.BoardSummary}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" Margin="0,5,0,4" />
              <TextBlock Text="{Binding HardwareStudio.BoardExpert}" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ (RAM)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding HardwareStudio.MemorySummary}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" Margin="0,5,0,4" />
              <TextBlock Text="{Binding HardwareStudio.MemoryExpert}" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="ВИДЕОКАРТА (GPU)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding HardwareStudio.GpuSummary}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" Margin="0,5,0,4" />
              <TextBlock Text="{Binding HardwareStudio.GpuExpert}" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="ДИСКИ И S.M.A.R.T." FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding HardwareStudio.StorageSummary}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" Margin="0,5,0,4" />
              <TextBlock Text="{Binding HardwareStudio.StorageExpert}" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="МОНИТОРЫ (EDID / ГЦ)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding HardwareStudio.DisplaySummary}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" Margin="0,5,0,4" />
              <TextBlock Text="{Binding HardwareStudio.DisplayExpert}" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Таблицы S.M.A.R.T. накопителей и планок памяти -->
        <Grid Height="210">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <DataGrid Grid.Column="0" ItemsSource="{Binding HardwareStudio.Drives}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Накопитель" Binding="{Binding Model}" Width="*" />
              <DataGridTextColumn Header="Шина" Binding="{Binding BusKind}" Width="80" />
              <DataGridTextColumn Header="Объем" Binding="{Binding FormattedCapacity}" Width="85" />
              <DataGridTextColumn Header="Темп °C" Binding="{Binding TemperatureC}" Width="68" />
              <DataGridTextColumn Header="Ресурс %" Binding="{Binding RemainingLifePercent}" Width="75" />
              <DataGridTextColumn Header="Запись ТБ" Binding="{Binding TotalBytesWrittenTb, StringFormat={}{0:F1}}" Width="80" />
            </DataGrid.Columns>
          </DataGrid>

          <DataGrid Grid.Column="2" ItemsSource="{Binding HardwareStudio.RamSticks}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Слот" Binding="{Binding DeviceLocator}" Width="75" />
              <DataGridTextColumn Header="Объем" Binding="{Binding FormattedCapacity}" Width="80" />
              <DataGridTextColumn Header="Частота МТ/с" Binding="{Binding ConfiguredSpeedMtPerSec}" Width="95" />
              <DataGridTextColumn Header="Модуль" Binding="{Binding PartNumber}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>

      </StackPanel>
    </ScrollViewer>

    <!-- ВКЛАДКА 1: ОФИЦИАЛЬНЫЕ WHQL-ДРАЙВЕРЫ (CFGMGR32 + WINDOWS UPDATE) -->
    <Grid Grid.Row="1"
          Margin="14,12"
          Visibility="{Binding HardwareStudio.IsDriversTab, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,10">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding DriverStudio.AuditDriversCommand}"
                  Content="Проверить драйверы"
                  VerticalAlignment="Center" Margin="14,0,0,0" />
          <StackPanel>
            <TextBlock Text="{Binding DriverStudio.DriverSummaryHeadline}" FontSize="12.5" TextWrapping="Wrap" />
            <DockPanel Margin="0,6,0,0">
              <CheckBox Style="{StaticResource PillToggleSwitchStyle}"
                        IsChecked="{Binding DriverStudio.QueryWindowsUpdateOnline}"
                        Margin="0,0,10,0" />
              <TextBlock Text="Запрашивать подписанные WHQL-обновления из официального каталога Microsoft Windows Update"
                         FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </DockPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <DataGrid Grid.Row="1" ItemsSource="{Binding DriverStudio.DriverFindings}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Устройство" Binding="{Binding SimpleTitle}" Width="240" />
          <DataGridTextColumn Header="Статус и рекомендация" Binding="{Binding SimpleExplanation}" Width="*" />
          <DataGridTextColumn Header="Hardware ID" Binding="{Binding ExpertTechnicalDetails}" Width="220" />
          <DataGridTemplateColumn Header="Действия" Width="210">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource PrimaryButtonStyle}" Padding="7,2" FontSize="11"
                          Visibility="{Binding CanInstallViaWindowsUpdate, Converter={StaticResource BoolToVis}}"
                          Command="{Binding InstallWhqlCommand}" Content="WHQL" Margin="0,0,4,0" />
                  <Button Style="{StaticResource CompactButtonStyle}" Padding="7,2" FontSize="11"
                          Visibility="{Binding CanBackupOemInf, Converter={StaticResource BoolToVis}}"
                          Command="{Binding BackupInfCommand}" Content="Бэкап INF" Margin="0,0,4,0" />
                  <Button Style="{StaticResource CompactButtonStyle}" Padding="7,2" FontSize="11"
                          Visibility="{Binding HasOfficialVendorUrl, Converter={StaticResource BoolToVis}}"
                          Command="{Binding OpenVendorPortalCommand}" Content="Сайт" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <!-- ВКЛАДКА 2: ТЕПЛОБЕЗОПАСНЫЙ СТРЕСС-ТЕСТ CPU И ПАМЯТИ -->
    <Grid Grid.Row="1"
          Margin="14,12"
          Visibility="{Binding HardwareStudio.IsStressTab, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Стресс-тест стабильности процессора и памяти (с защитой от перегрева)"
                     FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Text="Нагружает все логические потоки вычислительными матрицами и мгновенно прерывает тест при приближении к температурному порогу."
                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Длительность (сек):" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="70" Text="{Binding HardwareStudio.StressDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,0" />
            <TextBlock Text="Аварийная отсечка °C:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="70" Text="{Binding HardwareStudio.ThermalCutoffCelsius, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,0" />
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding HardwareStudio.CanStartStress}"
                    Command="{Binding HardwareStudio.StartStressTestCommand}"
                    Content="Запустить тест" Margin="0,0,8,0" />
            <Button Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding HardwareStudio.StopStressTestCommand}"
                    Content="Остановить" />
          </StackPanel>

          <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6" Padding="14,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding HardwareStudio.StressThroughputText}"
                         FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding HardwareStudio.StressStatusText}" FontSize="13" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
