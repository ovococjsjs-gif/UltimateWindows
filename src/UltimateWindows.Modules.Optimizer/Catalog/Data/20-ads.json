{
  "schemaVersion": 2,

  "tweaks": [
    {
      "id": "ads.disable-start-suggestions",
      "category": "AdsAndSuggestions",
      "title": "Не показывать рекомендуемые приложения в меню «Пуск»",
      "explanation": "Из меню «Пуск» пропадают плитки и строки с приложениями, которые Microsoft предлагает установить.",
      "risk": "Safe",
      "actions": [
        { "type": "registry", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SystemPaneSuggestionsEnabled", "kind": "dword", "value": 0, "default": 1 },
        { "type": "registry", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338388Enabled", "kind": "dword", "value": 0, "default": 1 }
      ]
    },
    {
      "id": "ads.disable-start-recommendations",
      "category": "AdsAndSuggestions",
      "title": "Не показывать советы и продвижение приложений в меню «Пуск»",
      "explanation": "В разделе «Рекомендуем» меню «Пуск» остаются только ваши недавние файлы и приложения, без советов и предложений из Microsoft Store.",
      "risk": "Safe",
      "requirements": { "minWindowsBuild": 22621 },
      "actions": [
        { "type": "registry", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_IrisRecommendations", "kind": "dword", "value": 0, "default": 1 }
      ]
    },
    {
      "id": "ads.disable-silent-app-installs",
      "category": "AdsAndSuggestions",
      "title": "Запретить автоматическую установку рекомендованных приложений",
      "explanation": "Windows перестаёт сама устанавливать продвигаемые приложения и игры из Microsoft Store. Уже установленные остаются — их можно удалить на вкладке «Приложения».",
      "risk": "Safe",
      "actions": [
        { "type": "registry", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SilentInstalledAppsEnabled", "kind": "dword", "value": 0, "default": 1 },
        { "type": "registry", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "PreInstalledAppsEnabled", "kind": "dword", "value": 0, "default": 1 },
        { "type": "registry", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "OemPreInstalledAppsEnabled", "kind": "dword", "value": 0, "default": 1 }
      ]
    },
    {
      "id": "ads.disable-lock-screen-tips",
      "category": "AdsAndSuggestions",
      "title": "Убрать советы и рекламу с экрана блокировки",
      "explanation": "С экрана блокировки пропадают «интересные факты», советы и предложения. Картинка остаётся прежней.",
      "risk": "Safe",
      "actions": [
        { "type": "registry", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "RotatingLockScreenOverlayEnabled", "kind": "dword", "value": 0, "default": 1 },
        { "type": "registry", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338387Enabled", "kind": "dword", "value": 0, "default": 1 }
      ]
    },
    {
      "id": "ads.disable-tips",
      "category": "AdsAndSuggestions",
      "title": "Не показывать советы и подсказки по Windows",
      "explanation": "Windows перестаёт присылать уведомления с советами, как пользоваться системой и службами Microsoft.",
      "risk": "Safe",
      "actions": [
        { "type": "registry", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SoftLandingEnabled", "kind": "dword", "value": 0, "default": 1 },
        { "type": "registry", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338389Enabled", "kind": "dword", "value": 0, "default": 1 }
      ]
    },
    {
