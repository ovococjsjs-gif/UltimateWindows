    {
      "id": "app.chrome-no-telemetry",
      "category": "Applications",
      "title": "Google Chrome: отключить отправку статистики",
      "explanation": "Chrome перестаёт отправлять в Google статистику использования и отчёты о сбоях и не предлагает отправить отзыв. В браузере появится пометка «Управляется организацией».",
      "risk": "Safe",
      "requirements": {
        "installedAny": [
          "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\chrome.exe",
          "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\chrome.exe"
