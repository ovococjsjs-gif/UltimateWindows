        "installedNote": "Google Chrome не установлен."
      },
      "actions": [
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Google\\Chrome", "name": "MetricsReportingEnabled", "kind": "dword", "value": 0 },
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Google\\Chrome", "name": "UserFeedbackAllowed", "kind": "dword", "value": 0 }
      ]
    },
    {
      "id": "app.chrome-no-background",
      "category": "Applications",
      "title": "Google Chrome: не работать в фоне",
      "explanation": "Chrome полностью закрывается вместе с последним окном. Расширения и сайты перестают работать в фоне: уведомления сайтов не будут приходить, пока браузер закрыт.",
      "risk": "Safe",
      "requirements": {
        "installedAny": [
          "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\chrome.exe",
          "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\chrome.exe"
        ],
        "installedNote": "Google Chrome не установлен."
      },
      "actions": [
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Google\\Chrome", "name": "BackgroundModeEnabled", "kind": "dword", "value": 0 }
      ]
    },
    {
      "id": "app.firefox-no-telemetry",
      "category": "Applications",
      "title": "Mozilla Firefox: отключить телеметрию",
      "explanation": "Firefox перестаёт отправлять технические данные и данные о взаимодействии, не участвует в исследованиях и не запускает фоновую проверку браузера по умолчанию.",
      "risk": "Safe",
      "requirements": {
        "installedAny": [
          "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\firefox.exe",
          "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\firefox.exe"
        ],
        "installedNote": "Mozilla Firefox не установлен."
      },
      "actions": [
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Mozilla\\Firefox", "name": "DisableTelemetry", "kind": "dword", "value": 1 },
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Mozilla\\Firefox", "name": "DisableFirefoxStudies", "kind": "dword", "value": 1 },
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Mozilla\\Firefox", "name": "DisableDefaultBrowserAgent", "kind": "dword", "value": 1 }
      ]
    },
    {
