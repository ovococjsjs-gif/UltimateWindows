        "installedNote": "Microsoft Office не установлен."
      },
      "actions": [
        { "type": "registry", "hive": "HKCU", "key": "Software\\Policies\\Microsoft\\Office\\16.0\\osm", "name": "Enablelogging", "kind": "dword", "value": 0 },
        { "type": "registry", "hive": "HKCU", "key": "Software\\Policies\\Microsoft\\Office\\16.0\\osm", "name": "EnableUpload", "kind": "dword", "value": 0 },
        { "type": "registry", "hive": "HKCU", "key": "Software\\Policies\\Microsoft\\Office\\Common\\ClientTelemetry", "name": "DisableTelemetry", "kind": "dword", "value": 1 },
        { "type": "registry", "hive": "HKCU", "key": "Software\\Policies\\Microsoft\\Office\\16.0\\Common", "name": "QMEnable", "kind": "dword", "value": 0 },
        { "type": "registry", "hive": "HKCU", "key": "Software\\Policies\\Microsoft\\Office\\16.0\\Common\\Feedback", "name": "Enabled", "kind": "dword", "value": 0 },
        { "type": "task", "path": "\\Microsoft\\Office\\OfficeTelemetryAgentLogOn2016", "enabled": false },
        { "type": "task", "path": "\\Microsoft\\Office\\OfficeTelemetryAgentFallBack2016", "enabled": false }
