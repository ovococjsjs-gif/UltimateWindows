{
  "schemaVersion": 2,

  "tweaks": [
    {
      "id": "app.edge-no-background",
      "category": "Applications",
      "title": "Microsoft Edge: не работать в фоне",
      "explanation": "Edge перестаёт запускаться вместе с Windows «для ускорения» и не остаётся в памяти после закрытия последнего окна. Первое открытие Edge станет чуть медленнее. В браузере появится пометка «Управляется организацией».",
      "risk": "Safe",
      "actions": [
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Edge", "name": "StartupBoostEnabled", "kind": "dword", "value": 0 },
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Edge", "name": "BackgroundModeEnabled", "kind": "dword", "value": 0 }
      ]
    },
    {
      "id": "app.edge-no-telemetry",
      "category": "Applications",
      "title": "Microsoft Edge: отключить телеметрию",
      "explanation": "Edge перестаёт отправлять необязательные диагностические данные, использовать историю просмотров для персонализации рекламы и предлагать оставить отзыв.",
      "risk": "Safe",
      "actions": [
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Edge", "name": "DiagnosticData", "kind": "dword", "value": 0 },
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Edge", "name": "PersonalizationReportingEnabled", "kind": "dword", "value": 0 },
        { "type": "registry", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Edge", "name": "UserFeedbackAllowed", "kind": "dword", "value": 0 }
      ]
    },
    {
