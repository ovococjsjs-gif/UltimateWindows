  "tweaks": [
    {
      "id": "sys.disable-error-reporting-wer",
      "category": "SystemAndPerformance",
      "icon": "SYS",
      "title": "Отключить отчеты об ошибках Windows (WER)",
      "explanation": "Прекращает фоновый сбор и отправку тяжелых дампов при закрытии программ.",
      "impact": "Меньше фоновой нагрузки",
      "risk": "Safe",
