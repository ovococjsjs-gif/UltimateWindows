<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UltimateWindows.Modules.Optimizer</RootNamespace>
    <Description>Модуль Фазы 4: декларативный движок обратимых твиков ОС (с YAML-профилями), менеджер автозагрузки и контекстного меню ShellEx, File Lock Hunter, настройка DNS/сети и менеджер программ.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Каталог твиков — файл данных, встроенный в сборку. Формат описан в docs/06-TWEAK-CATALOG.md -->
    <EmbeddedResource Include="Catalog\tweaks.json" LogicalName="UltimateWindows.Optimizer.tweaks.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltimateWindows.Core\UltimateWindows.Core.csproj" />
  </ItemGroup>
</Project>
