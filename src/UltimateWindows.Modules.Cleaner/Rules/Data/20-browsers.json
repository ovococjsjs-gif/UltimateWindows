    {
      "id": "browser.chrome.crash-reports",
      "section": "Browsers",
      "app": "Google Chrome",
      "title": "Отчёты о сбоях и статистика",
      "explanation": "Отчёты о сбоях браузера и служебная статистика его работы. Нужны только разработчикам браузера.",
      "kind": "Dumps",
      "default": true,
      "processes": [
        "chrome"
      ],
      "files": [
        {
          "path": "%LocalAppData%\\Google\\Chrome\\User Data\\Crashpad\\reports"
        },
        {
          "path": "%LocalAppData%\\Google\\Chrome\\User Data\\BrowserMetrics",
          "match": [
            "*.pma"
          ]
        }
      ]
    },
    {
      "id": "browser.chrome.ai-model",
      "section": "Browsers",
      "app": "Google Chrome",
      "title": "Локальная модель ИИ",
      "explanation": "Модель для встроенных в Chrome функций ИИ. Занимает несколько гигабайт и хранится на диске, даже если этими функциями не пользуются.",
      "kind": "Other",
      "default": false,
      "warning": "Если функции ИИ в Chrome включены, браузер скачает модель заново.",
      "processes": [
        "chrome"
      ],
      "skipWhileRunning": true,
      "files": [
        {
          "path": "%LocalAppData%\\Google\\Chrome\\User Data\\OptGuideOnDeviceModel"
        }
      ]
    },
