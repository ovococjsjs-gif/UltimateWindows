{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "browser.chrome.cache",
      "section": "Browsers",
      "app": "Google Chrome",
      "title": "Кэш",
      "explanation": "Копии страниц, картинок и скриптов, сохранённые для ускорения загрузки сайтов. Браузер скачает их заново; пароли, история, закладки и вход на сайтах сохраняются.",
      "kind": "Cache",
      "default": true,
      "processes": [
        "chrome"
      ],
      "files": [
        {
          "path": "%LocalAppData%\\Google\\Chrome\\User Data\\*\\Cache\\Cache_Data"
        },
        {
          "path": "%LocalAppData%\\Google\\Chrome\\User Data\\*\\Code Cache"
        },
        {
          "path": "%LocalAppData%\\Google\\Chrome\\User Data\\*\\GPUCache"
        },
        {
          "path": "%LocalAppData%\\Google\\Chrome\\User Data\\*\\DawnCache"
