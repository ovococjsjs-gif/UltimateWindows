{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "util.java.cache",
      "section": "Utilities",
      "app": "Java",
      "title": "Кэш и журналы",
      "explanation": "Кэш и журналы устаревших веб-компонентов Java.",
      "kind": "Cache",
      "default": true,
      "files": [
        {
          "path": "%LocalLow%\\Sun\\Java\\Deployment\\cache"
        },
        {
          "path": "%LocalLow%\\Sun\\Java\\Deployment\\log"
        }
      ]
    },
    {
      "id": "util.qbittorrent.logs",
      "section": "Utilities",
      "app": "qBittorrent",
      "title": "Журналы",
      "explanation": "Журналы работы программы. Нужны только при поиске причин неполадок.",
      "kind": "Logs",
      "default": true,
      "files": [
        {
          "path": "%LocalAppData%\\qBittorrent\\logs"
        }
      ]
    },
    {
      "id": "util.anydesk.logs",
      "section": "Utilities",
      "app": "AnyDesk",
      "title": "Журналы",
      "explanation": "Журналы работы программы. Нужны только при поиске причин неполадок.",
      "kind": "Logs",
      "default": true,
      "files": [
        {
          "path": "%AppData%\\AnyDesk",
          "match": [
            "*.trace"
          ],
          "recurse": false
        }
      ]
    },
    {
      "id": "util.powertoys.logs",
      "section": "Utilities",
      "app": "PowerToys",
      "title": "Журналы",
      "explanation": "Журналы работы программы. Нужны только при поиске причин неполадок.",
      "kind": "Logs",
      "default": true,
      "files": [
        {
          "path": "%LocalAppData%\\Microsoft\\PowerToys\\Logs"
        },
        {
          "path": "%LocalAppData%\\Microsoft\\PowerToys\\*\\Logs"
        }
      ]
    },
    {
      "id": "util.google-drive.logs",
      "section": "Utilities",
      "app": "Google Диск",
      "title": "Журналы",
      "explanation": "Журналы синхронизации. Файлы в облаке и на диске не затрагиваются.",
      "kind": "Logs",
      "default": true,
      "minAgeHours": 24,
      "files": [
        {
          "path": "%LocalAppData%\\Google\\DriveFS\\Logs"
        }
      ]
    },
    {
      "id": "util.chocolatey.logs",
      "section": "Utilities",
      "app": "Chocolatey",
      "title": "Журналы",
      "explanation": "Журналы работы программы. Нужны только при поиске причин неполадок.",
      "kind": "Logs",
      "default": true,
      "minAgeHours": 24,
      "files": [
        {
          "path": "%ProgramData%\\chocolatey\\logs",
          "match": [
            "*.log"
          ]
        }
      ]
    },
    {
      "id": "util.scoop.cache",
      "section": "Utilities",
      "app": "Scoop",
      "title": "Скачанные установщики",
      "explanation": "Установщики программ, которые Scoop уже установил. При переустановке скачаются заново.",
      "kind": "Cache",
      "default": false,
      "files": [
        {
          "path": "%UserProfile%\\scoop\\cache"
        }
      ]
    },
