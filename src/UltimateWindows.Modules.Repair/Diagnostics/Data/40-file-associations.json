{
  "schemaVersion": 1,
  "section": "FileAssociations",
  "rules": [
    {
      "id": "assoc.exe-launch",
      "title": "Ассоциация запуска программ .exe (exefile)",
      "symptom": "Ни одна программа .exe не запускается или Windows спрашивает «Каким приложением открыть этот файл .exe?».",
      "explanation": "Повреждена базовая привязка HKCR\\.exe -> exefile, команда запуска \"%1\" %* или создан ошибочный выбор UserChoice для .exe.",
      "fixSummary": "Восстанавливает привязку .exe -> exefile, команду \"%1\" %* и удаляет битый UserChoice для .exe.",
      "severity": "Critical",
      "risk": "Safe",
      "requiresAdmin": true,
      "reversible": true,
      "registry": [
        {
          "hive": "HKCR",
          "subKey": ".exe",
          "valueName": "",
          "expectation": "MustEqualString",
          "expectedString": "exefile",
          "fixKind": "SetString",
          "fixString": "exefile"
        },
        {
          "hive": "HKCR",
          "subKey": "exefile\\shell\\open\\command",
          "valueName": "",
          "expectation": "MustEqualString",
          "expectedString": "\"%1\" %*",
          "fixKind": "SetString",
          "fixString": "\"%1\" %*"
        },
        {
          "hive": "HKCU",
          "subKey": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\.exe\\UserChoice",
          "valueName": "ProgId",
          "expectation": "MustNotExist",
          "fixKind": "DeleteValue"
        }
      ]
    },
    {
      "id": "assoc.lnk-shortcuts",
      "title": "Ассоциация ярлыков Рабочего стола и меню «Пуск» (.lnk -> lnkfile)",
      "symptom": "Все ярлыки на Рабочем столе получили один значок и открываются в Блокноте, браузере или Word.",
      "explanation": "Случайно выбрана программа «Открыть с помощью» для файла ярлыка .lnk (создан UserChoice\\ProgId) либо сбит класс lnkfile.",
      "fixSummary": "Возвращает .lnk -> lnkfile, атрибут IsShortcut и удаляет ошибочный UserChoice для ярлыков.",
      "severity": "Critical",
      "risk": "Safe",
      "requiresAdmin": true,
      "reversible": true,
      "registry": [
        {
          "hive": "HKCR",
          "subKey": ".lnk",
          "valueName": "",
          "expectation": "MustEqualString",
          "expectedString": "lnkfile",
          "fixKind": "SetString",
          "fixString": "lnkfile"
        },
        {
          "hive": "HKCU",
          "subKey": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\.lnk\\UserChoice",
          "valueName": "ProgId",
          "expectation": "MustNotExist",
          "fixKind": "DeleteValue"
        }
      ]
    },
    {
      "id": "assoc.msi-package",
      "title": "Ассоциация пакетов установщика Windows (.msi -> Msi.Package)",
      "symptom": "Двойной клик по установочному файлу .msi не запускает установку программы.",
      "explanation": "Нарушена связь расширения .msi с обработчиком Msi.Package.",
      "fixSummary": "Восстанавливает привязку HKCR\\.msi -> Msi.Package и удаляет неверный UserChoice.",
      "severity": "Broken",
      "risk": "Safe",
      "requiresAdmin": true,
      "reversible": true,
      "errorCodes": ["1619"],
      "registry": [
        {
          "hive": "HKCR",
          "subKey": ".msi",
          "valueName": "",
          "expectation": "MustEqualString",
          "expectedString": "Msi.Package",
          "fixKind": "SetString",
          "fixString": "Msi.Package"
        },
        {
          "hive": "HKCU",
          "subKey": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\.msi\\UserChoice",
          "valueName": "ProgId",
          "expectation": "MustNotExist",
          "fixKind": "DeleteValue"
        }
      ]
    },
