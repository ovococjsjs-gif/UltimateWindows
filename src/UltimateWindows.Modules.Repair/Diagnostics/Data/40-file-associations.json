    {
      "id": "assoc.vbs-wsh",
      "title": "Разблокировка сервера сценариев Windows Script Host (WSH Enabled)",
      "symptom": "При запуске .vbs / .js скриптов автоматизации выдаётся «Доступ к серверу сценариев Windows на этом компьютере отключён».",
      "explanation": "В разделе Windows Script Host\\Settings установлен параметр Enabled = 0.",
      "fixSummary": "Удаляет блокировку Enabled = 0 для Windows Script Host.",
      "severity": "Info",
      "risk": "Low",
      "requiresAdmin": true,
      "reversible": true,
      "registry": [
        {
          "hive": "HKLM",
          "subKey": "SOFTWARE\\Microsoft\\Windows Script Host\\Settings",
          "valueName": "Enabled",
          "expectation": "MustNotEqualDword",
          "expectedDword": 0,
          "fixKind": "DeleteValue",
          "onlyIfKeyExists": true
        },
        {
          "hive": "HKCU",
          "subKey": "Software\\Microsoft\\Windows Script Host\\Settings",
          "valueName": "Enabled",
          "expectation": "MustNotEqualDword",
          "expectedDword": 0,
          "fixKind": "DeleteValue",
          "onlyIfKeyExists": true
        }
      ]
    },
    {
      "id": "assoc.policy-no-associate",
      "title": "Политика запрета смены приложений по умолчанию (NoFileAssociate)",
      "symptom": "Не удаётся сменить браузер, плеер или просмотрщик PDF по умолчанию в Параметрах Windows.",
      "explanation": "В политиках Explorer установлен параметр NoFileAssociate = 1.",
      "fixSummary": "Удаляет ограничение NoFileAssociate в HKCU и HKLM.",
      "severity": "Warning",
      "risk": "Safe",
      "requiresAdmin": true,
      "reversible": true,
      "registry": [
        {
          "hive": "HKCU",
          "subKey": "Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
          "valueName": "NoFileAssociate",
          "expectation": "MustNotExist",
          "fixKind": "DeleteValue"
        },
        {
          "hive": "HKLM",
          "subKey": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
          "valueName": "NoFileAssociate",
          "expectation": "MustNotExist",
          "fixKind": "DeleteValue"
        }
      ]
    }
