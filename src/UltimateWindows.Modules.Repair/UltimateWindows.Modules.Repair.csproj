<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UltimateWindows.Modules.Repair</RootNamespace>
    <Description>Модуль Этапа 3 (Ремонт и DLL 2.0): диагностический движок «обнаружить → объяснить → исправить → проверить», справочник кодов ошибок, разбор CBS.log и сбоев программ, PE-доктор, сканер зависимостей установленных программ и каталог официальных сред выполнения с проверкой подписи.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltimateWindows.Core\UltimateWindows.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Diagnostics\Data\*.json">
      <LogicalName>UltimateWindows.Repair.Diagnostics.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
